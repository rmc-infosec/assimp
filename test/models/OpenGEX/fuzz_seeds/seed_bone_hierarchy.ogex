Material $skin_mat
{
    Name {string {"SkinMat"}}
    Color (attrib = "diffuse") {float[3] {{0.85, 0.65, 0.5}}}
    Color (attrib = "specular") {float[3] {{0.3, 0.3, 0.3}}}
    Color (attrib = "emission") {float[3] {{0.02, 0.01, 0.0}}}

    Texture (attrib = "diffuse")
    {
        string {"textures/skin_diffuse.png"}
    }
    Texture (attrib = "normal")
    {
        string {"textures/skin_normal.png"}
    }
}

Material $child_mat
{
    Name {string {"ChildMat"}}
    Color (attrib = "diffuse") {float[4] {{0.5, 0.5, 0.9, 0.8}}}
    Color (attrib = "specular") {float[4] {{1.0, 1.0, 1.0, 1.0}}}

    Texture (attrib = "specular_power")
    {
        string {"textures/child_specpow.png"}
    }
    Texture (attrib = "opacity")
    {
        string {"textures/child_opacity.png"}
    }
}
