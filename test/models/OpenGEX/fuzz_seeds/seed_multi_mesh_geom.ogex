Material $mat_red
{
    Name {string {"Red"}}
    Color (attrib = "diffuse") {float[3] {{0.9, 0.1, 0.1}}}
    Color (attrib = "specular") {float[3] {{1.0, 0.8, 0.8}}}
    Param (attrib = "specular_power") {float {60.0}}

    Texture (attrib = "diffuse")
    {
        string {"textures/red_diffuse.png"}
    }
}

Material $mat_green
{
    Name {string {"Green"}}
    Color (attrib = "diffuse") {float[3] {{0.1, 0.8, 0.1}}}
    Color (attrib = "specular") {float[4] {{0.5, 1.0, 0.5, 1.0}}}
    Color (attrib = "emission") {float[3] {{0.05, 0.2, 0.05}}}
}

Material $mat_blue
{
    Name {string {"Blue"}}
    Color (attrib = "diffuse") {float[4] {{0.1, 0.2, 0.9, 0.8}}}

    Texture (attrib = "normal")
    {
        string {"textures/blue_normal.png"}
    }
    Texture (attrib = "specular")
    {
        string {"textures/blue_spec.png"}
    }
}

Material $mat_textured
{
    Name {string {"FullTextured"}}
    Color (attrib = "diffuse") {float[3] {{1.0, 1.0, 1.0}}}
    Color (attrib = "specular") {float[3] {{0.9, 0.9, 0.9}}}
    Color (attrib = "emission") {float[3] {{0.0, 0.0, 0.0}}}

    Param (attrib = "specular_power") {float {128.0}}

    Texture (attrib = "diffuse")
    {
        string {"textures/checker_diffuse.png"}
    }
    Texture (attrib = "specular")
    {
        string {"textures/checker_spec.png"}
    }
    Texture (attrib = "emission")
    {
        string {"textures/checker_emit.png"}
    }
    Texture (attrib = "opacity")
    {
        string {"textures/checker_alpha.png"}
    }
    Texture (attrib = "normal")
    {
        string {"textures/checker_normal.png"}
    }
}
