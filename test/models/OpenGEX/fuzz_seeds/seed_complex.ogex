CameraObject $camera1
{
    Param (attrib = "fov") {float {0.785}}
    Param (attrib = "near") {float {0.01}}
    Param (attrib = "far") {float {2000.0}}
}

Material $mat_red
{
    Name {string {"Red"}}
    Color (attrib = "diffuse") {float[3] {{0.9, 0.1, 0.1}}}
    Color (attrib = "specular") {float[3] {{1.0, 0.8, 0.8}}}
    Param (attrib = "specular_power") {float {60.0}}
}

Material $mat_green
{
    Name {string {"Green"}}
    Color (attrib = "diffuse") {float[3] {{0.1, 0.9, 0.1}}}
    Color (attrib = "specular") {float[3] {{0.8, 1.0, 0.8}}}
    Color (attrib = "emission") {float[3] {{0.02, 0.1, 0.02}}}
}

Material $mat_blue
{
    Name {string {"Blue"}}
    Color (attrib = "diffuse") {float[4] {{0.1, 0.2, 0.9, 1.0}}}
    Color (attrib = "specular") {float[3] {{0.5, 0.5, 1.0}}}
}

Material $mat_textured
{
    Name {string {"TexturedMat"}}
    Color (attrib = "diffuse") {float[3] {{1.0, 1.0, 1.0}}}

    Texture (attrib = "diffuse")
    {
        string {"textures/checker.png"}
    }
    Texture (attrib = "normal")
    {
        string {"textures/checker_normal.png"}
    }
    Texture (attrib = "specular")
    {
        string {"textures/checker_spec.png"}
    }
    Texture (attrib = "emission")
    {
        string {"textures/checker_emit.png"}
    }
    Texture (attrib = "opacity")
    {
        string {"textures/checker_alpha.png"}
    }
}
