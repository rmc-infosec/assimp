Metric (key = "distance") {float {1.0}}
Metric (key = "angle") {float {1.0}}
Metric (key = "time") {float {1.0}}
Metric (key = "up") {string {"z"}}

GeometryNode $node_cube
{
    Name {string {"Cube"}}
    ObjectRef {ref {$geo_cube}}
    MaterialRef {ref {$mat_red}}

    Transform
    {
        float[16]
        {
            {2, 0, 0, 0, 0, 2, 0, 0, 0, 0, 2, 0, -3, 0, 0, 1}
        }
    }
}

