*3DSMAX_ASCIIEXPORT	200
*COMMENT "Fuzz seed - mesh with bone weights via MESH_WEIGHTS"
*SCENE {
	*SCENE_FILENAME "skeleton"
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0000	0.0000	0.0000
	*SCENE_AMBIENT_STATIC 0.1000	0.1000	0.1000
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "SkinMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2000	0.2000	0.2000
		*MATERIAL_DIFFUSE 0.8000	0.7000	0.6000
		*MATERIAL_SPECULAR 1.0000	1.0000	1.0000
		*MATERIAL_SHINE 0.2500
		*MATERIAL_SHINESTRENGTH 0.0500
		*MATERIAL_TRANSPARENCY 0.0000
		*MATERIAL_SHADING Phong
		*MATERIAL_SELFILLUM 0.0000
	}
}
*GEOMOBJECT {
	*NODE_NAME "SkinnedQuad"
	*NODE_PARENT "Bone01"
	*NODE_TM {
		*NODE_NAME "SkinnedQuad"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 0.0000	0.0000	0.0000
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX    0	-1.0000	0.0000	0.0000
			*MESH_VERTEX    1	1.0000	0.0000	0.0000
			*MESH_VERTEX    2	1.0000	0.0000	2.0000
			*MESH_VERTEX    3	-1.0000	0.0000	2.0000
		}
		*MESH_FACE_LIST {
			*MESH_FACE    0:    A:    0 B:    1 C:    2 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
			*MESH_FACE    1:    A:    0 B:    2 C:    3 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0	0.0000	0.0000	0.0000
			*MESH_TVERT 1	1.0000	0.0000	0.0000
			*MESH_TVERT 2	1.0000	1.0000	0.0000
			*MESH_TVERT 3	0.0000	1.0000	0.0000
		}
		*MESH_NUMTVFACES 2
		*MESH_TFACELIST {
			*MESH_TFACE 0	0	1	2
			*MESH_TFACE 1	0	2	3
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 0	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 1	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 2	0.0000	-1.0000	0.0000
			*MESH_FACENORMAL 1	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 0	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 2	0.0000	-1.0000	0.0000
				*MESH_VERTEXNORMAL 3	0.0000	-1.0000	0.0000
		}
		*MESH_WEIGHTS {
			*MESH_NUMBONE 3
			*MESH_BONE_LIST {
				*MESH_BONE_NAME 0 "Bone01"
				*MESH_BONE_NAME 1 "Bone02"
				*MESH_BONE_NAME 2 "Bone03"
			}
			*MESH_NUMVERTEX 4
			*MESH_BONE_VERTEX_LIST {
				*MESH_BONE_VERTEX 0	-1.0000	0.0000	0.0000
					0 0.9000
					1 0.1000
				*MESH_BONE_VERTEX 1	1.0000	0.0000	0.0000
					0 0.8000
					1 0.2000
				*MESH_BONE_VERTEX 2	1.0000	0.0000	2.0000
					1 0.5000
					2 0.5000
				*MESH_BONE_VERTEX 3	-1.0000	0.0000	2.0000
					0 0.2000
					1 0.3000
					2 0.5000
			}
		}
	}
	*MATERIAL_REF 0
}
