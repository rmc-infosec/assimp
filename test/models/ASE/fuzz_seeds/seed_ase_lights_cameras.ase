*3DSMAX_ASCIIEXPORT 200
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 0
}
*CAMERAOBJECT {
	*NODE_NAME "Camera_Target"
	*CAMERA_TYPE target
	*NODE_TM {
		*NODE_NAME "Camera_Target"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 10.0 -20.0 5.0
	}
	*NODE_TM {
		*NODE_NAME "Camera_Target.Target"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*CAMERA_SETTINGS {
		*CAMERA_NEAR 1.0
		*CAMERA_FAR 1000.0
		*CAMERA_FOV 0.785
	}
	*TM_ANIMATION {
		*NODE_NAME "Camera_Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 10.0 -20.0 5.0
			*CONTROL_POS_SAMPLE 480 15.0 -15.0 5.0
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "Camera_Target.Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 0.0
			*CONTROL_POS_SAMPLE 480 2.0 3.0 0.0
		}
	}
}
*CAMERAOBJECT {
	*NODE_NAME "Camera_Free"
	*CAMERA_TYPE free
	*NODE_TM {
		*NODE_NAME "Camera_Free"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 5.0 5.0 5.0
	}
	*CAMERA_SETTINGS {
		*CAMERA_NEAR 0.5
		*CAMERA_FAR 500.0
		*CAMERA_FOV 1.047
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Light_Omni"
	*LIGHT_TYPE omni
	*NODE_TM {
		*NODE_NAME "Light_Omni"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 10.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 0.9 0.8
		*LIGHT_INTENS 1.5
		*LIGHT_HOTSPOT 45.0
		*LIGHT_FALLOFF 60.0
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Light_Target"
	*LIGHT_TYPE target
	*NODE_TM {
		*NODE_NAME "Light_Target"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -5.0 0.0 8.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 0.5 0.5 1.0
		*LIGHT_INTENS 2.0
	}
	*TM_ANIMATION {
		*NODE_NAME "Light_Target.Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 0.0
			*CONTROL_POS_SAMPLE 480 1.0 1.0 0.0
		}
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Light_Dir"
	*LIGHT_TYPE directional
	*NODE_TM {
		*NODE_NAME "Light_Dir"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 20.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 1.0 1.0
		*LIGHT_INTENS 1.0
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Light_Free"
	*LIGHT_TYPE free
	*NODE_TM {
		*NODE_NAME "Light_Free"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 3.0 3.0 3.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 0.8 1.0 0.8
		*LIGHT_INTENS 0.8
		*LIGHT_HOTSPOT 30.0
		*LIGHT_FALLOFF 50.0
	}
}
