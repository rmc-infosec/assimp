*3DSMAX_ASCIIEXPORT	200
*COMMENT "3D texture coords (non-zero Z) and higher mapping channels 4-5"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "MultiChanMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.8 0.8
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "diffuse.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "MultiChanPlane"
	*NODE_TM {
		*NODE_NAME "MultiChanPlane"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -2.0 -2.0 0.0
			*MESH_VERTEX 1  2.0 -2.0 0.0
			*MESH_VERTEX 2  2.0  2.0 0.0
			*MESH_VERTEX 3 -2.0  2.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.5
			*MESH_TVERT 1 1.0 0.0 0.5
			*MESH_TVERT 2 1.0 1.0 0.5
			*MESH_TVERT 3 0.0 1.0 0.5
		}
		*MESH_NUMTVFACES 2
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
			*MESH_TFACE 1 0 2 3
		}
		*MESH_MAPPINGCHANNEL 2 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0 0.0 0.0 0.25
				*MESH_TVERT 1 0.5 0.0 0.25
				*MESH_TVERT 2 0.5 0.5 0.25
				*MESH_TVERT 3 0.0 0.5 0.25
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0 0 1 2
				*MESH_TFACE 1 0 2 3
			}
		}
		*MESH_MAPPINGCHANNEL 3 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0 0.1 0.1 0.75
				*MESH_TVERT 1 0.9 0.1 0.75
				*MESH_TVERT 2 0.9 0.9 0.75
				*MESH_TVERT 3 0.1 0.9 0.75
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0 0 1 2
				*MESH_TFACE 1 0 2 3
			}
		}
		*MESH_MAPPINGCHANNEL 4 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0 0.2 0.2 1.0
				*MESH_TVERT 1 0.8 0.2 1.0
				*MESH_TVERT 2 0.8 0.8 1.0
				*MESH_TVERT 3 0.2 0.8 1.0
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0 0 1 2
				*MESH_TFACE 1 0 2 3
			}
		}
		*MESH_MAPPINGCHANNEL 5 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0 0.3 0.3 0.0
				*MESH_TVERT 1 0.7 0.3 0.0
				*MESH_TVERT 2 0.7 0.7 0.0
				*MESH_TVERT 3 0.3 0.7 0.0
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0 0 1 2
				*MESH_TFACE 1 0 2 3
			}
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 0 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 1 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 2 0.0 0.0 1.0
			*MESH_FACENORMAL 1 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 0 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 2 0.0 0.0 1.0
				*MESH_VERTEXNORMAL 3 0.0 0.0 1.0
		}
	}
	*MATERIAL_REF 0
}
