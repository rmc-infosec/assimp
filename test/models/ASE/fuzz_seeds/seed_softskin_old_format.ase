*3DSMAX_ASCIIEXPORT	110
*COMMENT "Old ASC format with MESH_SOFTSKINVERTS block"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "SkinMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.7 0.6
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.25
		*MATERIAL_SHINESTRENGTH 0.05
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Phong
		*MATERIAL_SELFILLUM 0.0
	}
}
*GEOMOBJECT {
	*NODE_NAME "SoftSkinMesh"
	*NODE_TM {
		*NODE_NAME "SoftSkinMesh"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 6
		*MESH_NUMFACES 4
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -1.0 0.0 0.0
			*MESH_VERTEX 1  1.0 0.0 0.0
			*MESH_VERTEX 2  1.0 0.0 2.0
			*MESH_VERTEX 3 -1.0 0.0 2.0
			*MESH_VERTEX 4  1.0 0.0 4.0
			*MESH_VERTEX 5 -1.0 0.0 4.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 3 B: 2 C: 4 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 3: A: 3 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 1 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
			*MESH_FACENORMAL 1 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
			*MESH_FACENORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 4 0.0 -1.0 0.0
			*MESH_FACENORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 4 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 5 0.0 -1.0 0.0
		}
	}
	*MATERIAL_REF 0
}
*MESH_SOFTSKINVERTS {
SoftSkinMesh
6
2 "Bone_Upper" 0.9 "Bone_Lower" 0.1
2 "Bone_Upper" 0.8 "Bone_Lower" 0.2
2 "Bone_Upper" 0.5 "Bone_Lower" 0.5
2 "Bone_Upper" 0.5 "Bone_Lower" 0.5
2 "Bone_Upper" 0.2 "Bone_Lower" 0.8
2 "Bone_Upper" 0.1 "Bone_Lower" 0.9
}
