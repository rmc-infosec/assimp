*3DSMAX_ASCIIEXPORT	200
*COMMENT "Multiple material refs with submaterials - exercises full BuildMaterialIndices path"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 30
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.1 0.1 0.2
	*SCENE_AMBIENT_STATIC 0.05 0.05 0.05
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 3
	*MATERIAL 0 {
		*MATERIAL_NAME "SimpleMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.8 0.8
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "simple_diff.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "SubMat4"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.5 0.5 0.5
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Phong
		*MATERIAL_SELFILLUM 0.0
		*NUMSUBMTLS 4
		*SUBMATERIAL 0 {
			*MATERIAL_NAME "Red"
			*MATERIAL_AMBIENT 0.2 0.0 0.0
			*MATERIAL_DIFFUSE 1.0 0.0 0.0
			*MATERIAL_SPECULAR 1.0 0.5 0.5
			*MATERIAL_SHINE 0.3
			*MATERIAL_SHINESTRENGTH 0.2
			*MATERIAL_TRANSPARENCY 0.0
			*MATERIAL_SHADING Flat
			*MATERIAL_SELFILLUM 0.0
			*MAP_DIFFUSE {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "red.tga"
			}
		}
		*SUBMATERIAL 1 {
			*MATERIAL_NAME "Green"
			*MATERIAL_AMBIENT 0.0 0.2 0.0
			*MATERIAL_DIFFUSE 0.0 1.0 0.0
			*MATERIAL_SPECULAR 0.5 1.0 0.5
			*MATERIAL_SHINE 0.5
			*MATERIAL_SHINESTRENGTH 0.3
			*MATERIAL_TRANSPARENCY 0.1
			*MATERIAL_SHADING Gouraud
			*MATERIAL_SELFILLUM 0.1
			*MAP_DIFFUSE {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "green.tga"
			}
			*MAP_BUMP {
				*MAP_CLASS "Normal Bump"
				*MAP_AMOUNT 0.5
				*BITMAP "green_bump.tga"
			}
		}
		*SUBMATERIAL 2 {
			*MATERIAL_NAME "Blue"
			*MATERIAL_AMBIENT 0.0 0.0 0.2
			*MATERIAL_DIFFUSE 0.0 0.0 1.0
			*MATERIAL_SPECULAR 0.5 0.5 1.0
			*MATERIAL_SHINE 0.7
			*MATERIAL_SHINESTRENGTH 0.5
			*MATERIAL_TRANSPARENCY 0.2
			*MATERIAL_SHADING Wire
			*MATERIAL_SELFILLUM 0.2
			*MAP_SPECULAR {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.8
				*BITMAP "blue_spec.tga"
			}
			*MAP_SELFILLUM {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.5
				*BITMAP "blue_emit.tga"
			}
		}
		*SUBMATERIAL 3 {
			*MATERIAL_NAME "Yellow"
			*MATERIAL_AMBIENT 0.2 0.2 0.0
			*MATERIAL_DIFFUSE 1.0 1.0 0.0
			*MATERIAL_SPECULAR 1.0 1.0 0.5
			*MATERIAL_SHINE 0.9
			*MATERIAL_SHINESTRENGTH 0.8
			*MATERIAL_TRANSPARENCY 0.0
			*MATERIAL_SHADING Metal
			*MATERIAL_SELFILLUM 0.0
			*MAP_AMBIENT {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.4
				*BITMAP "yellow_amb.tga"
			}
			*MAP_OPACITY {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "yellow_opacity.tga"
			}
			*MAP_SHINESTRENGTH {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.6
				*BITMAP "yellow_gloss.tga"
			}
		}
	}
	*MATERIAL 2 {
		*MATERIAL_NAME "TransparentMat"
		*MATERIAL_AMBIENT 0.1 0.1 0.1
		*MATERIAL_DIFFUSE 0.9 0.9 0.9
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.8
		*MATERIAL_SHINESTRENGTH 0.6
		*MATERIAL_TRANSPARENCY 0.5
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.3
		*MAP_OPACITY {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "glass_opacity.tga"
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "SimplePlane"
	*NODE_TM {
		*NODE_NAME "SimplePlane"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -2.0 -2.0 0.0
			*MESH_VERTEX 1  2.0 -2.0 0.0
			*MESH_VERTEX 2  2.0  2.0 0.0
			*MESH_VERTEX 3 -2.0  2.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "SubMatBox"
	*NODE_TM {
		*NODE_NAME "SubMatBox"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 5.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 8
		*MESH_NUMFACES 12
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 4.0 -1.0 0.0
			*MESH_VERTEX 1 6.0 -1.0 0.0
			*MESH_VERTEX 2 6.0  1.0 0.0
			*MESH_VERTEX 3 4.0  1.0 0.0
			*MESH_VERTEX 4 4.0 -1.0 2.0
			*MESH_VERTEX 5 6.0 -1.0 2.0
			*MESH_VERTEX 6 6.0  1.0 2.0
			*MESH_VERTEX 7 4.0  1.0 2.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 4 B: 6 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 1
			*MESH_FACE 3: A: 4 B: 7 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 1
			*MESH_FACE 4: A: 0 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 2
			*MESH_FACE 5: A: 0 B: 5 C: 1 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 2
			*MESH_FACE 6: A: 1 B: 5 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 3
			*MESH_FACE 7: A: 1 B: 6 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 3
			*MESH_FACE 8: A: 2 B: 6 C: 7 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 5 *MESH_MTLID 0
			*MESH_FACE 9: A: 2 B: 7 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 5 *MESH_MTLID 1
			*MESH_FACE 10: A: 3 B: 7 C: 4 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 6 *MESH_MTLID 2
			*MESH_FACE 11: A: 3 B: 4 C: 0 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 6 *MESH_MTLID 3
		}
	}
	*MATERIAL_REF 1
}
*GEOMOBJECT {
	*NODE_NAME "TransPlane"
	*NODE_TM {
		*NODE_NAME "TransPlane"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -5.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -6.0 -1.0 0.0
			*MESH_VERTEX 1 -4.0 -1.0 0.0
			*MESH_VERTEX 2 -4.0  1.0 0.0
			*MESH_VERTEX 3 -6.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 2
}
