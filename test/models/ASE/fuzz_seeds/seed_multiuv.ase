*3DSMAX_ASCIIEXPORT	200
*COMMENT "Fuzz seed - multiple UV mapping channels"
*SCENE {
	*SCENE_FILENAME "multiuv"
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.2000	0.2000	0.3000
	*SCENE_AMBIENT_STATIC 0.1000	0.1000	0.1000
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "MultiUVMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2000	0.2000	0.2000
		*MATERIAL_DIFFUSE 0.8000	0.8000	0.8000
		*MATERIAL_SPECULAR 1.0000	1.0000	1.0000
		*MATERIAL_SHINE 0.5000
		*MATERIAL_SHINESTRENGTH 0.3000
		*MATERIAL_TRANSPARENCY 0.0000
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0000
		*MAP_DIFFUSE {
			*MAP_NAME "diffuse_ch1"
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0000
			*BITMAP "diffuse.png"
			*UVW_U_OFFSET 0.0000
			*UVW_V_OFFSET 0.0000
			*UVW_U_TILING 1.0000
			*UVW_V_TILING 1.0000
			*UVW_ANGLE 0.0000
		}
		*MAP_AMBIENT {
			*MAP_NAME "ambient_tex"
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.5000
			*BITMAP "ambient.png"
			*UVW_U_OFFSET 0.1000
			*UVW_V_OFFSET 0.2000
			*UVW_U_TILING 2.0000
			*UVW_V_TILING 2.0000
			*UVW_ANGLE 0.7854
		}
		*MAP_SHINESTRENGTH {
			*MAP_NAME "gloss_tex"
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.8000
			*BITMAP "gloss.png"
			*UVW_U_OFFSET 0.0000
			*UVW_V_OFFSET 0.0000
			*UVW_U_TILING 1.0000
			*UVW_V_TILING 1.0000
			*UVW_ANGLE 0.0000
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "MultiUVPlane"
	*NODE_TM {
		*NODE_NAME "MultiUVPlane"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 0.0000	0.0000	0.0000
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX    0	-2.0000	-2.0000	0.0000
			*MESH_VERTEX    1	2.0000	-2.0000	0.0000
			*MESH_VERTEX    2	2.0000	2.0000	0.0000
			*MESH_VERTEX    3	-2.0000	2.0000	0.0000
		}
		*MESH_FACE_LIST {
			*MESH_FACE    0:    A:    0 B:    1 C:    2 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
			*MESH_FACE    1:    A:    0 B:    2 C:    3 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0	0.0000	0.0000	0.0000
			*MESH_TVERT 1	1.0000	0.0000	0.0000
			*MESH_TVERT 2	1.0000	1.0000	0.0000
			*MESH_TVERT 3	0.0000	1.0000	0.0000
		}
		*MESH_NUMTVFACES 2
		*MESH_TFACELIST {
			*MESH_TFACE 0	0	1	2
			*MESH_TFACE 1	0	2	3
		}
		*MESH_NUMCVERTEX 4
		*MESH_CVERTLIST {
			*MESH_VERTCOL 0	1.0000	0.0000	0.0000
			*MESH_VERTCOL 1	0.0000	1.0000	0.0000
			*MESH_VERTCOL 2	0.0000	0.0000	1.0000
			*MESH_VERTCOL 3	1.0000	1.0000	1.0000
		}
		*MESH_NUMCVFACES 2
		*MESH_CFACELIST {
			*MESH_CFACE 0	0	1	2
			*MESH_CFACE 1	0	2	3
		}
		*MESH_MAPPINGCHANNEL 2 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0	0.0000	0.0000	0.5000
				*MESH_TVERT 1	0.5000	0.0000	0.5000
				*MESH_TVERT 2	0.5000	0.5000	0.5000
				*MESH_TVERT 3	0.0000	0.5000	0.5000
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0	0	1	2
				*MESH_TFACE 1	0	2	3
			}
		}
		*MESH_MAPPINGCHANNEL 3 {
			*MESH_NUMTVERTEX 4
			*MESH_TVERTLIST {
				*MESH_TVERT 0	0.2000	0.2000	0.0000
				*MESH_TVERT 1	0.8000	0.2000	0.0000
				*MESH_TVERT 2	0.8000	0.8000	0.0000
				*MESH_TVERT 3	0.2000	0.8000	0.0000
			}
			*MESH_NUMTVFACES 2
			*MESH_TFACELIST {
				*MESH_TFACE 0	0	1	2
				*MESH_TFACE 1	0	2	3
			}
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 0	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 1	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 2	0.0000	0.0000	1.0000
			*MESH_FACENORMAL 1	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 0	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 2	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 3	0.0000	0.0000	1.0000
		}
	}
	*MATERIAL_REF 0
}
