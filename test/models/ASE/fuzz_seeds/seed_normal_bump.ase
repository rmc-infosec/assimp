*3DSMAX_ASCIIEXPORT	200
*COMMENT "Seed for Normal Bump MAP_CLASS - exercises MAP_CLASS validation branch"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 2
	*MATERIAL 0 {
		*MATERIAL_NAME "NormalBumpMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.7 0.7 0.7
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "diffuse_tex.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
		*MAP_BUMP {
			*MAP_CLASS "Normal Bump"
			*MAP_AMOUNT 1.0
			*BITMAP "normal_map.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "MixedMapClassMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.15 0.15 0.15
		*MATERIAL_DIFFUSE 0.6 0.5 0.4
		*MATERIAL_SPECULAR 0.9 0.9 0.9
		*MATERIAL_SHINE 0.4
		*MATERIAL_SHINESTRENGTH 0.2
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Phong
		*MATERIAL_SELFILLUM 0.0
		*MAP_DIFFUSE {
			*MAP_CLASS "Normal Bump"
			*MAP_AMOUNT 0.8
			*BITMAP "normal_diffuse.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 2.0
			*UVW_V_TILING 2.0
			*UVW_ANGLE 0.0
		}
		*MAP_SPECULAR {
			*MAP_CLASS "Checker"
			*MAP_AMOUNT 0.5
			*BITMAP "checker_spec.tga"
		}
		*MAP_BUMP {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.7
			*BITMAP "bump_tex.tga"
		}
		*MAP_OPACITY {
			*MAP_CLASS "Gradient"
			*MAP_AMOUNT 1.0
			*BITMAP "gradient_opacity.tga"
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "NormalBumpBox"
	*NODE_TM {
		*NODE_NAME "NormalBumpBox"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 8
		*MESH_NUMFACES 12
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -1.0 -1.0 0.0
			*MESH_VERTEX 1  1.0 -1.0 0.0
			*MESH_VERTEX 2  1.0  1.0 0.0
			*MESH_VERTEX 3 -1.0  1.0 0.0
			*MESH_VERTEX 4 -1.0 -1.0 2.0
			*MESH_VERTEX 5  1.0 -1.0 2.0
			*MESH_VERTEX 6  1.0  1.0 2.0
			*MESH_VERTEX 7 -1.0  1.0 2.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 4 B: 6 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 3: A: 4 B: 7 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 4: A: 0 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 0
			*MESH_FACE 5: A: 0 B: 5 C: 1 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 0
			*MESH_FACE 6: A: 1 B: 5 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 0
			*MESH_FACE 7: A: 1 B: 6 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 0
			*MESH_FACE 8: A: 2 B: 6 C: 7 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 5 *MESH_MTLID 0
			*MESH_FACE 9: A: 2 B: 7 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 5 *MESH_MTLID 0
			*MESH_FACE 10: A: 3 B: 7 C: 4 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 6 *MESH_MTLID 0
			*MESH_FACE 11: A: 3 B: 4 C: 0 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 6 *MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.0
			*MESH_TVERT 1 1.0 0.0 0.0
			*MESH_TVERT 2 1.0 1.0 0.0
			*MESH_TVERT 3 0.0 1.0 0.0
		}
		*MESH_NUMTVFACES 12
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
			*MESH_TFACE 1 0 2 3
			*MESH_TFACE 2 0 2 1
			*MESH_TFACE 3 0 3 2
			*MESH_TFACE 4 0 3 1
			*MESH_TFACE 5 0 1 2
			*MESH_TFACE 6 0 1 2
			*MESH_TFACE 7 0 2 3
			*MESH_TFACE 8 0 2 3
			*MESH_TFACE 9 0 3 1
			*MESH_TFACE 10 0 3 1
			*MESH_TFACE 11 0 1 2
		}
	}
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "MixedPlane"
	*NODE_TM {
		*NODE_NAME "MixedPlane"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 4.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 3.0 -1.0 0.0
			*MESH_VERTEX 1 5.0 -1.0 0.0
			*MESH_VERTEX 2 5.0  1.0 0.0
			*MESH_VERTEX 3 3.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 1
}
