		*MATERIAL_TWOSIDED
		*MATERIAL_SELFILLUM 0.3000
		*MATERIAL_WIRESIZE 2.0000
		*MATERIAL_XP_FALLOFF 0.5000
		*MATERIAL_FALLOFF In
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "WireMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.0000	0.0000	0.0000
		*MATERIAL_DIFFUSE 0.0000	0.8000	0.0000
		*MATERIAL_SPECULAR 0.5000	0.5000	0.5000
