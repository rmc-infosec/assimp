*3DSMAX_ASCIIEXPORT	200
*COMMENT "Fuzz seed - advanced material properties and shading types"
*SCENE {
	*SCENE_FILENAME "advmat"
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.1000	0.1000	0.2000
	*SCENE_AMBIENT_STATIC 0.0500	0.0500	0.0500
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 4
	*MATERIAL 0 {
		*MATERIAL_NAME "FlatTwoSided"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.1000	0.1000	0.1000
		*MATERIAL_DIFFUSE 0.9000	0.2000	0.2000
		*MATERIAL_SPECULAR 1.0000	1.0000	1.0000
