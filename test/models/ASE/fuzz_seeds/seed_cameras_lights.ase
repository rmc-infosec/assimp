*3DSMAX_ASCIIEXPORT	200
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 50
	*SCENE_FRAMESPEED 24
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.05 0.05 0.1
	*SCENE_AMBIENT_STATIC 0.2 0.2 0.2
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "Mat01"
		*MATERIAL_DIFFUSE 0.8 0.6 0.4
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHADING Wire
		*MATERIAL_TRANSPARENCY 0.1
		*MATERIAL_SELFILLUM 0.05
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.7
		*MATERIAL_TWOSIDED
	}
}
*CAMERAOBJECT {
	*NODE_NAME "Cam"
	*CAMERA_TYPE Target
	*NODE_TM {
		*NODE_NAME "Cam"
		*TM_ROW0 0.7 -0.7 0.0
		*TM_ROW1 0.0 0.0 1.0
		*TM_ROW2 -0.7 -0.7 0.0
		*TM_ROW3 -20.0 -20.0 15.0
	}
	*NODE_TM {
		*NODE_NAME "Cam.Target"
		*TM_ROW3 0.0 0.0 3.0
	}
	*CAMERA_SETTINGS {
		*CAMERA_NEAR 0.5
		*CAMERA_FAR 1000.0
		*CAMERA_FOV 0.785
	}
	*TM_ANIMATION {
		*NODE_NAME "Cam"
		*CONTROL_POS_BEZIER {
			*CONTROL_BEZIER_POS_KEY 0 -20.0 -20.0 15.0 0 0 0 0 0 0
			*CONTROL_BEZIER_POS_KEY 1920 -15.0 -15.0 18.0 1 1 0 1 1 0
		}
		*CONTROL_ROT_BEZIER {
			*CONTROL_BEZIER_ROT_KEY 0 0.0 0.0 1.0 0.0
			*CONTROL_BEZIER_ROT_KEY 1920 0.0 0.0 1.0 0.2
		}
		*CONTROL_SCALE_BEZIER {
			*CONTROL_BEZIER_SCALE_KEY 0 1.0 1.0 1.0
			*CONTROL_BEZIER_SCALE_KEY 1920 1.1 1.1 1.1
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "Cam.Target"
		*CONTROL_POS_TCB {
			*CONTROL_TCB_POS_KEY 0 0.0 0.0 3.0
			*CONTROL_TCB_POS_KEY 1920 2.0 2.0 3.0
		}
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Spot"
	*LIGHT_TYPE Target
	*NODE_TM {
		*NODE_NAME "Spot"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 0.0 1.0
		*TM_ROW2 0.0 -1.0 0.0
		*TM_ROW3 5.0 5.0 10.0
	}
	*NODE_TM {
		*NODE_NAME "Spot.Target"
		*TM_ROW3 0.0 0.0 0.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 0.9 0.8
		*LIGHT_INTENS 1.5
		*LIGHT_HOTSPOT 30.0
		*LIGHT_FALLOFF 50.0
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Dir"
	*LIGHT_TYPE Directional
	*NODE_TM {
		*NODE_NAME "Dir"
		*TM_ROW3 50.0 50.0 50.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 1.0 0.95
		*LIGHT_INTENS 0.6
	}
}
*GEOMOBJECT {
	*NODE_NAME "Box"
	*NODE_TM {
		*NODE_NAME "Box"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0	-1.0 -1.0 0.0
			*MESH_VERTEX 1	 1.0 -1.0 0.0
			*MESH_VERTEX 2	 1.0  1.0 0.0
			*MESH_VERTEX 3	-1.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 1	*MESH_SMOOTHING 1	*MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 1	*MESH_SMOOTHING 1	*MESH_MTLID 1
		}
		*MESH_NUMCVERTEX 4
		*MESH_CVERTLIST {
			*MESH_VERTCOL 0	1.0 0.0 0.0
			*MESH_VERTCOL 1	0.0 1.0 0.0
			*MESH_VERTCOL 2	0.0 0.0 1.0
			*MESH_VERTCOL 3	1.0 1.0 0.0
		}
		*MESH_NUMCVFACES 2
		*MESH_CFACELIST {
			*MESH_CFACE 0	0 1 2
			*MESH_CFACE 1	0 2 3
		}
	}
	*MATERIAL_REF 0
}
