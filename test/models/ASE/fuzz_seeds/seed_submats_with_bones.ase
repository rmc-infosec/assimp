*3DSMAX_ASCIIEXPORT	200
*COMMENT "Sub-materials with bones - exercises submaterial split + bone copy path"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "BonedSubMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.8 0.8
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0
		*NUMSUBMTLS 2
		*SUBMATERIAL 0 {
			*MATERIAL_NAME "SubSkin"
			*MATERIAL_AMBIENT 0.2 0.1 0.1
			*MATERIAL_DIFFUSE 0.9 0.7 0.6
			*MATERIAL_SPECULAR 1.0 1.0 1.0
			*MATERIAL_SHINE 0.3
			*MATERIAL_SHINESTRENGTH 0.2
			*MATERIAL_TRANSPARENCY 0.0
			*MATERIAL_SHADING Phong
			*MATERIAL_SELFILLUM 0.0
			*MAP_DIFFUSE {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "skin_diffuse.tga"
				*UVW_U_OFFSET 0.0
				*UVW_V_OFFSET 0.0
				*UVW_U_TILING 1.0
				*UVW_V_TILING 1.0
			}
			*MAP_BUMP {
				*MAP_CLASS "Normal Bump"
				*MAP_AMOUNT 0.4
				*BITMAP "skin_normal.tga"
			}
		}
		*SUBMATERIAL 1 {
			*MATERIAL_NAME "SubCloth"
			*MATERIAL_AMBIENT 0.1 0.1 0.2
			*MATERIAL_DIFFUSE 0.3 0.3 0.8
			*MATERIAL_SPECULAR 0.5 0.5 0.5
			*MATERIAL_SHINE 0.2
			*MATERIAL_SHINESTRENGTH 0.1
			*MATERIAL_TRANSPARENCY 0.0
			*MATERIAL_SHADING Flat
			*MATERIAL_TWOSIDED
			*MATERIAL_SELFILLUM 0.0
			*MAP_DIFFUSE {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "cloth_diffuse.tga"
			}
			*MAP_OPACITY {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "cloth_opacity.tga"
			}
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "BonedMesh"
	*NODE_TM {
		*NODE_NAME "BonedMesh"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 8
		*MESH_NUMFACES 8
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -1.0 0.0 0.0
			*MESH_VERTEX 1  1.0 0.0 0.0
			*MESH_VERTEX 2  1.0 0.0 2.0
			*MESH_VERTEX 3 -1.0 0.0 2.0
			*MESH_VERTEX 4  1.0 0.0 4.0
			*MESH_VERTEX 5 -1.0 0.0 4.0
			*MESH_VERTEX 6  1.0 0.0 6.0
			*MESH_VERTEX 7 -1.0 0.0 6.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 3 B: 2 C: 4 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 3: A: 3 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 4: A: 5 B: 4 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 1
			*MESH_FACE 5: A: 5 B: 6 C: 7 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 1
			*MESH_FACE 6: A: 0 B: 3 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 1
			*MESH_FACE 7: A: 0 B: 5 C: 7 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 4 *MESH_MTLID 1
		}
		*MESH_NUMTVERTEX 8
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.0
			*MESH_TVERT 1 1.0 0.0 0.0
			*MESH_TVERT 2 1.0 0.333 0.0
			*MESH_TVERT 3 0.0 0.333 0.0
			*MESH_TVERT 4 1.0 0.666 0.0
			*MESH_TVERT 5 0.0 0.666 0.0
			*MESH_TVERT 6 1.0 1.0 0.0
			*MESH_TVERT 7 0.0 1.0 0.0
		}
		*MESH_NUMTVFACES 8
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
			*MESH_TFACE 1 0 2 3
			*MESH_TFACE 2 3 2 4
			*MESH_TFACE 3 3 4 5
			*MESH_TFACE 4 5 4 6
			*MESH_TFACE 5 5 6 7
			*MESH_TFACE 6 0 3 5
			*MESH_TFACE 7 0 5 7
		}
		*MESH_NUMCVERTEX 8
		*MESH_CVERTLIST {
			*MESH_VERTCOL 0 1.0 0.8 0.6
			*MESH_VERTCOL 1 1.0 0.8 0.6
			*MESH_VERTCOL 2 0.8 0.6 0.4
			*MESH_VERTCOL 3 0.8 0.6 0.4
			*MESH_VERTCOL 4 0.5 0.5 0.8
			*MESH_VERTCOL 5 0.5 0.5 0.8
			*MESH_VERTCOL 6 0.3 0.3 0.8
			*MESH_VERTCOL 7 0.3 0.3 0.8
		}
		*MESH_NUMCVFACES 8
		*MESH_CFACELIST {
			*MESH_CFACE 0 0 1 2
			*MESH_CFACE 1 0 2 3
			*MESH_CFACE 2 3 2 4
			*MESH_CFACE 3 3 4 5
			*MESH_CFACE 4 5 4 6
			*MESH_CFACE 5 5 6 7
			*MESH_CFACE 6 0 3 5
			*MESH_CFACE 7 0 5 7
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 1 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
			*MESH_FACENORMAL 1 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 0 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
			*MESH_FACENORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 2 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 4 0.0 -1.0 0.0
			*MESH_FACENORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 3 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 4 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 5 0.0 -1.0 0.0
			*MESH_FACENORMAL 4 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 5 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 4 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 6 0.0 -1.0 0.0
			*MESH_FACENORMAL 5 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 5 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 6 0.0 -1.0 0.0
				*MESH_VERTEXNORMAL 7 0.0 -1.0 0.0
		}
		*MESH_WEIGHTS {
			*MESH_NUMBONE 3
			*MESH_BONE_LIST {
				*MESH_BONE_NAME 0 "Bone_Hip"
				*MESH_BONE_NAME 1 "Bone_Torso"
				*MESH_BONE_NAME 2 "Bone_Head"
			}
			*MESH_NUMVERTEX 8
			*MESH_BONE_VERTEX_LIST {
				*MESH_BONE_VERTEX 0 -1.0 0.0 0.0
					0 0.95
					1 0.05
				*MESH_BONE_VERTEX 1 1.0 0.0 0.0
					0 0.95
					1 0.05
				*MESH_BONE_VERTEX 2 1.0 0.0 2.0
					0 0.5
					1 0.5
				*MESH_BONE_VERTEX 3 -1.0 0.0 2.0
					0 0.5
					1 0.5
				*MESH_BONE_VERTEX 4 1.0 0.0 4.0
					1 0.5
					2 0.5
				*MESH_BONE_VERTEX 5 -1.0 0.0 4.0
					1 0.5
					2 0.5
				*MESH_BONE_VERTEX 6 1.0 0.0 6.0
					1 0.05
					2 0.95
				*MESH_BONE_VERTEX 7 -1.0 0.0 6.0
					1 0.05
					2 0.95
			}
		}
	}
	*MATERIAL_REF 0
}
