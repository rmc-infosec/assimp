*3DSMAX_ASCIIEXPORT	200
*COMMENT "Seed for HELPEROBJECT node with Wire and Flat shading models"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 3
	*MATERIAL 0 {
		*MATERIAL_NAME "WireMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.0 1.0 0.0
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.1
		*MATERIAL_SHINESTRENGTH 0.05
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Wire
		*MATERIAL_SELFILLUM 0.0
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "wire_tex.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "FlatMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.1 0.1 0.1
		*MATERIAL_DIFFUSE 0.8 0.2 0.2
		*MATERIAL_SPECULAR 0.5 0.5 0.5
		*MATERIAL_SHINE 0.0
		*MATERIAL_SHINESTRENGTH 0.0
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Flat
		*MATERIAL_SELFILLUM 0.0
	}
	*MATERIAL 2 {
		*MATERIAL_NAME "GouraudMat"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.5 0.5 0.8
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.3
		*MATERIAL_SHINESTRENGTH 0.1
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Gouraud
		*MATERIAL_SELFILLUM 0.0
	}
}
*HELPEROBJECT {
	*NODE_NAME "SceneRoot"
	*NODE_TM {
		*NODE_NAME "SceneRoot"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
}
*HELPEROBJECT {
	*NODE_NAME "GroupHelper"
	*NODE_PARENT "SceneRoot"
	*NODE_TM {
		*NODE_NAME "GroupHelper"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 3.0
	}
	*TM_ANIMATION {
		*NODE_NAME "GroupHelper"
		*CONTROL_POS_LINEAR {
			*CONTROL_POS_KEY 0 0.0 0.0 3.0
			*CONTROL_POS_KEY 4800 2.0 0.0 3.0
			*CONTROL_POS_KEY 9600 0.0 0.0 3.0
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "WireMesh"
	*NODE_PARENT "GroupHelper"
	*NODE_TM {
		*NODE_NAME "WireMesh"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -2.0 0.0 3.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -3.0 -1.0 3.0
			*MESH_VERTEX 1 -1.0 -1.0 3.0
			*MESH_VERTEX 2 -1.0  1.0 3.0
			*MESH_VERTEX 3 -3.0  1.0 3.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.0
			*MESH_TVERT 1 1.0 0.0 0.0
			*MESH_TVERT 2 1.0 1.0 0.0
			*MESH_TVERT 3 0.0 1.0 0.0
		}
		*MESH_NUMTVFACES 2
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
			*MESH_TFACE 1 0 2 3
		}
	}
	*PROP_MOTIONBLUR 0
	*PROP_CASTSHADOW 1
	*PROP_RECVSHADOW 1
	*WIREFRAME_COLOR 0.0 1.0 0.0
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "FlatMesh"
	*NODE_PARENT "SceneRoot"
	*NODE_TM {
		*NODE_NAME "FlatMesh"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 2.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 1.0 -1.0 0.0
			*MESH_VERTEX 1 3.0 -1.0 0.0
			*MESH_VERTEX 2 3.0  1.0 0.0
			*MESH_VERTEX 3 1.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 0 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 0 *MESH_MTLID 0
		}
	}
	*PROP_MOTIONBLUR 0
	*PROP_CASTSHADOW 0
	*PROP_RECVSHADOW 0
	*MATERIAL_REF 1
}
*GEOMOBJECT {
	*NODE_NAME "GouraudMesh"
	*NODE_TM {
		*NODE_NAME "GouraudMesh"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -5.0 0.0 0.0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -6.0 -1.0 0.0
			*MESH_VERTEX 1 -4.0 -1.0 0.0
			*MESH_VERTEX 2 -4.0  1.0 0.0
			*MESH_VERTEX 3 -6.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 2
}
