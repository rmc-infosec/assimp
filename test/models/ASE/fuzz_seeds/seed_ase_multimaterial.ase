*3DSMAX_ASCIIEXPORT 200
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 50
	*SCENE_FRAMESPEED 24
	*SCENE_TICKSPERFRAME 200
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 3
	*MATERIAL 0 {
		*MATERIAL_NAME "RedMat"
		*MATERIAL_AMBIENT 0.2 0.0 0.0
		*MATERIAL_DIFFUSE 0.9 0.1 0.1
		*MATERIAL_SPECULAR 1.0 0.5 0.5
		*MATERIAL_SHINE 0.6
		*MATERIAL_SHADING Wire
		*MAP_DIFFUSE {
			*MAP_NAME "RedTex"
			*MAP_CLASS "Bitmap"
			*BITMAP "red.tga"
			*MAP_AMOUNT 1.0
			*UVW_U_OFFSET 0.1
			*UVW_V_OFFSET -0.2
			*UVW_U_TILING 2.0
			*UVW_V_TILING 2.0
			*UVW_ANGLE 0.5
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "GreenMat"
		*MATERIAL_AMBIENT 0.0 0.2 0.0
		*MATERIAL_DIFFUSE 0.1 0.9 0.1
		*MATERIAL_SPECULAR 0.5 1.0 0.5
		*MATERIAL_SHINE 0.4
		*MATERIAL_SHADING Gouraud
	}
	*MATERIAL 2 {
		*MATERIAL_NAME "BlueMat"
		*MATERIAL_AMBIENT 0.0 0.0 0.2
		*MATERIAL_DIFFUSE 0.1 0.1 0.9
		*MATERIAL_SPECULAR 0.5 0.5 1.0
		*MATERIAL_SHINE 0.8
		*MATERIAL_SHADING Blinn
		*NUMSUBMTLS 2
		*SUBMATERIAL 0 {
			*MATERIAL_NAME "BlueSub0"
			*MATERIAL_DIFFUSE 0.2 0.2 1.0
			*MATERIAL_SHADING Phong
		}
		*SUBMATERIAL 1 {
			*MATERIAL_NAME "BlueSub1"
			*MATERIAL_DIFFUSE 0.1 0.1 0.7
			*MATERIAL_SHADING Flat
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "RedTriangle"
	*NODE_TM {
		*NODE_NAME "RedTriangle"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 3
		*MESH_NUMFACES 1
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 0.0 0.0 0.0
			*MESH_VERTEX 1 2.0 0.0 0.0
			*MESH_VERTEX 2 1.0 2.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 3
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.0
			*MESH_TVERT 1 1.0 0.0 0.0
			*MESH_TVERT 2 0.5 1.0 0.0
		}
		*MESH_NUMTVFACES 1
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
		}
	}
	*MATERIAL_REF 0
	*TM_ANIMATION {
		*NODE_NAME "RedTriangle"
		*CONTROL_POS_BEZIER {
			*CONTROL_BEZIER_POS_KEY 0 0.0 0.0 0.0
			*CONTROL_BEZIER_POS_KEY 200 1.0 0.0 0.0
			*CONTROL_BEZIER_POS_KEY 400 2.0 1.0 0.0
		}
		*CONTROL_ROT_TCB {
			*CONTROL_TCB_ROT_KEY 0 0.0 0.0 1.0 0.0
			*CONTROL_TCB_ROT_KEY 200 0.0 0.0 1.0 0.785
			*CONTROL_TCB_ROT_KEY 400 0.0 0.0 1.0 1.571
		}
		*CONTROL_SCALE_BEZIER {
			*CONTROL_BEZIER_SCALE_KEY 0 1.0 1.0 1.0
			*CONTROL_BEZIER_SCALE_KEY 200 1.5 1.5 1.5
			*CONTROL_BEZIER_SCALE_KEY 400 1.0 1.0 1.0
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "GreenQuad"
	*NODE_PARENT "RedTriangle"
	*NODE_TM {
		*NODE_NAME "GreenQuad"
