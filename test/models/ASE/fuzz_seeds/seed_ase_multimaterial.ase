			*MESH_VERTEX 3 0.0 1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 1
	*TM_ANIMATION {
		*NODE_NAME "GreenQuad"
		*CONTROL_POS_TCB {
			*CONTROL_TCB_POS_KEY 0 3.0 0.0 0.0
			*CONTROL_TCB_POS_KEY 200 3.0 2.0 0.0
			*CONTROL_TCB_POS_KEY 400 3.0 0.0 0.0
		}
		*CONTROL_SCALE_TCB {
			*CONTROL_TCB_SCALE_KEY 0 1.0 1.0 1.0
			*CONTROL_TCB_SCALE_KEY 200 2.0 2.0 2.0
			*CONTROL_TCB_SCALE_KEY 400 1.0 1.0 1.0
		}
	}
}
