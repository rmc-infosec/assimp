*3DSMAX_ASCIIEXPORT	200
*COMMENT "Orphan nodes with unknown parents - exercises the orphan re-parenting path in BuildNodes"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 50
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "OrphanMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.6 0.6 0.8
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Gouraud
		*MATERIAL_SELFILLUM 0.0
	}
}
*GEOMOBJECT {
	*NODE_NAME "OrphanMesh01"
	*NODE_PARENT "NonExistentParent"
	*NODE_TM {
		*NODE_NAME "OrphanMesh01"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -1.0 -1.0 0.0
			*MESH_VERTEX 1  1.0 -1.0 0.0
			*MESH_VERTEX 2  1.0  1.0 0.0
			*MESH_VERTEX 3 -1.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "OrphanMesh02"
	*NODE_PARENT "AlsoNonExistent"
	*NODE_TM {
		*NODE_NAME "OrphanMesh02"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 5.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 4.0 -1.0 0.0
			*MESH_VERTEX 1 6.0 -1.0 0.0
			*MESH_VERTEX 2 6.0  1.0 0.0
			*MESH_VERTEX 3 4.0  1.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "OrphanMesh02"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 5.0 0.0 0.0
			*CONTROL_POS_SAMPLE 1600 7.0 2.0 0.0
			*CONTROL_POS_SAMPLE 3200 5.0 0.0 0.0
		}
		*CONTROL_ROT_TRACK {
			*CONTROL_ROT_SAMPLE 0 0.0 0.0 1.0 0.0
			*CONTROL_ROT_SAMPLE 1600 0.0 0.0 1.0 0.7854
			*CONTROL_ROT_SAMPLE 3200 0.0 0.0 1.0 1.5708
		}
		*CONTROL_SCALE_TRACK {
			*CONTROL_SCALE_SAMPLE 0 1.0 1.0 1.0
			*CONTROL_SCALE_SAMPLE 1600 1.5 1.5 1.5
			*CONTROL_SCALE_SAMPLE 3200 1.0 1.0 1.0
		}
	}
	*MATERIAL_REF 0
}
*HELPEROBJECT {
	*NODE_NAME "OrphanHelper"
	*NODE_PARENT "GhostParent"
	*NODE_TM {
		*NODE_NAME "OrphanHelper"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -5.0 0.0 3.0
	}
	*TM_ANIMATION {
		*NODE_NAME "OrphanHelper"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 -5.0 0.0 3.0
			*CONTROL_POS_SAMPLE 1600 -3.0 2.0 3.0
			*CONTROL_POS_SAMPLE 3200 -5.0 0.0 3.0
		}
	}
}
