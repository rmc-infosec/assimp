*3DSMAX_ASCIIEXPORT	200
*COMMENT "Target camera with fully animated target - exercises BuildAnimations target path"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.1
	*SCENE_AMBIENT_STATIC 0.05 0.05 0.05
}
*CAMERAOBJECT {
	*NODE_NAME "AnimCam"
	*CAMERA_TYPE Target
	*NODE_TM {
		*NODE_NAME "AnimCam"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 0.7071 -0.7071 0.0
		*TM_ROW1 0.0 0.0 1.0
		*TM_ROW2 -0.7071 -0.7071 0.0
		*TM_ROW3 -20.0 -20.0 15.0
	}
	*NODE_TM {
		*NODE_NAME "AnimCam.Target"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 5.0
	}
	*CAMERA_SETTINGS {
		*CAMERA_NEAR 0.1
		*CAMERA_FAR 1000.0
		*CAMERA_FOV 0.7854
	}
	*TM_ANIMATION {
		*NODE_NAME "AnimCam"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 -20.0 -20.0 15.0
			*CONTROL_POS_SAMPLE 1600 -15.0 -15.0 18.0
			*CONTROL_POS_SAMPLE 3200 -10.0 -10.0 15.0
			*CONTROL_POS_SAMPLE 4800 -5.0 -5.0 12.0
		}
		*CONTROL_ROT_TRACK {
			*CONTROL_ROT_SAMPLE 0 0.0 0.0 1.0 0.0
			*CONTROL_ROT_SAMPLE 1600 0.0 0.0 1.0 0.3927
			*CONTROL_ROT_SAMPLE 3200 0.0 0.0 1.0 0.7854
			*CONTROL_ROT_SAMPLE 4800 0.0 0.0 1.0 1.1781
		}
		*CONTROL_SCALE_TRACK {
			*CONTROL_SCALE_SAMPLE 0 1.0 1.0 1.0
			*CONTROL_SCALE_SAMPLE 1600 1.1 1.1 1.1
			*CONTROL_SCALE_SAMPLE 3200 1.2 1.2 1.2
			*CONTROL_SCALE_SAMPLE 4800 1.0 1.0 1.0
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "AnimCam.Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 5.0
			*CONTROL_POS_SAMPLE 1600 3.0 3.0 5.0
			*CONTROL_POS_SAMPLE 3200 6.0 0.0 5.0
			*CONTROL_POS_SAMPLE 4800 9.0 3.0 5.0
		}
	}
}
*LIGHTOBJECT {
	*NODE_NAME "AnimSpot"
	*LIGHT_TYPE Target
	*NODE_TM {
		*NODE_NAME "AnimSpot"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 0.0 1.0
		*TM_ROW2 0.0 -1.0 0.0
		*TM_ROW3 10.0 10.0 20.0
	}
	*NODE_TM {
		*NODE_NAME "AnimSpot.Target"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 0.9 0.7
		*LIGHT_INTENS 2.5
		*LIGHT_HOTSPOT 30.0
		*LIGHT_FALLOFF 45.0
	}
	*TM_ANIMATION {
		*NODE_NAME "AnimSpot"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 10.0 10.0 20.0
			*CONTROL_POS_SAMPLE 1600 12.0 8.0 20.0
			*CONTROL_POS_SAMPLE 3200 14.0 10.0 20.0
			*CONTROL_POS_SAMPLE 4800 10.0 12.0 20.0
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "AnimSpot.Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 0.0
			*CONTROL_POS_SAMPLE 1600 2.0 2.0 0.0
			*CONTROL_POS_SAMPLE 3200 4.0 0.0 0.0
			*CONTROL_POS_SAMPLE 4800 2.0 -2.0 0.0
		}
	}
}
