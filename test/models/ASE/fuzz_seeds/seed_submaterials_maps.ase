*3DSMAX_ASCIIEXPORT	200
*COMMENT "Sub-materials with all supported MAP types"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.2 0.2 0.3
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 2
	*MATERIAL 0 {
		*MATERIAL_NAME "AllMaps"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.6 0.4
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.65
		*MATERIAL_SHINESTRENGTH 0.5
		*MATERIAL_TRANSPARENCY 0.1
		*MATERIAL_SHADING Phong
		*MATERIAL_TWOSIDED
		*MATERIAL_SELFILLUM 0.15
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "diffuse.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
		*MAP_AMBIENT {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.5
			*BITMAP "ambient.tga"
			*UVW_U_OFFSET 0.1
			*UVW_V_OFFSET 0.2
			*UVW_U_TILING 2.0
			*UVW_V_TILING 2.0
		}
		*MAP_SPECULAR {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.8
			*BITMAP "specular.tga"
		}
		*MAP_BUMP {
			*MAP_CLASS "Normal Bump"
			*MAP_AMOUNT 0.3
			*BITMAP "normal.tga"
		}
		*MAP_OPACITY {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "opacity.tga"
		}
		*MAP_SELFILLUM {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.7
			*BITMAP "emissive.tga"
		}
		*MAP_SHINESTRENGTH {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.6
			*BITMAP "gloss.tga"
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "MultiSubMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.5 0.5 0.5
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.5
		*MATERIAL_SHINESTRENGTH 0.3
		*MATERIAL_TRANSPARENCY 0.0
		*MATERIAL_SHADING Blinn
		*MATERIAL_SELFILLUM 0.0
		*NUMSUBMTLS 3
		*SUBMATERIAL 0 {
			*MATERIAL_NAME "SubRed"
			*MATERIAL_AMBIENT 0.2 0.0 0.0
			*MATERIAL_DIFFUSE 1.0 0.0 0.0
			*MATERIAL_SPECULAR 1.0 1.0 1.0
			*MATERIAL_SHINE 0.3
			*MATERIAL_SHINESTRENGTH 0.2
			*MATERIAL_TRANSPARENCY 0.0
			*MATERIAL_SHADING Flat
			*MATERIAL_TWOSIDED
			*MATERIAL_SELFILLUM 0.0
			*MAP_DIFFUSE {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "red.tga"
			}
		}
		*SUBMATERIAL 1 {
			*MATERIAL_NAME "SubGreen"
			*MATERIAL_AMBIENT 0.0 0.2 0.0
			*MATERIAL_DIFFUSE 0.0 1.0 0.0
			*MATERIAL_SPECULAR 1.0 1.0 1.0
			*MATERIAL_SHINE 0.7
			*MATERIAL_SHINESTRENGTH 0.5
			*MATERIAL_TRANSPARENCY 0.2
			*MATERIAL_SHADING Wire
			*MATERIAL_SELFILLUM 0.1
			*MAP_BUMP {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.5
				*BITMAP "green_normal.tga"
			}
			*MAP_OPACITY {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 1.0
				*BITMAP "green_opacity.tga"
			}
			*MAP_AMBIENT {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.4
				*BITMAP "green_amb.tga"
			}
		}
		*SUBMATERIAL 2 {
			*MATERIAL_NAME "SubBlue"
			*MATERIAL_AMBIENT 0.0 0.0 0.2
			*MATERIAL_DIFFUSE 0.0 0.0 1.0
			*MATERIAL_SPECULAR 1.0 1.0 1.0
			*MATERIAL_SHINE 0.9
			*MATERIAL_SHINESTRENGTH 0.8
			*MATERIAL_TRANSPARENCY 0.5
			*MATERIAL_SHADING Phong
			*MATERIAL_SELFILLUM 0.3
			*MAP_SPECULAR {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.9
				*BITMAP "blue_spec.tga"
			}
			*MAP_SELFILLUM {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.6
				*BITMAP "blue_emit.tga"
			}
			*MAP_SHINESTRENGTH {
				*MAP_CLASS "Bitmap"
				*MAP_AMOUNT 0.7
				*BITMAP "blue_gloss.tga"
			}
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "AllMapsPlane"
	*NODE_TM {
		*NODE_NAME "AllMapsPlane"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -2.0 -2.0 0.0
			*MESH_VERTEX 1  2.0 -2.0 0.0
			*MESH_VERTEX 2  2.0  2.0 0.0
			*MESH_VERTEX 3 -2.0  2.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
		}
	}
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "SubMatMesh"
	*NODE_TM {
		*NODE_NAME "SubMatMesh"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 5.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 6
		*MESH_NUMFACES 4
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 4.0 -2.0 0.0
			*MESH_VERTEX 1 6.0 -2.0 0.0
			*MESH_VERTEX 2 6.0  0.0 0.0
			*MESH_VERTEX 3 4.0  0.0 0.0
			*MESH_VERTEX 4 6.0  2.0 0.0
			*MESH_VERTEX 5 4.0  2.0 0.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 3 B: 2 C: 4 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 1
			*MESH_FACE 3: A: 3 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 2
		}
	}
	*MATERIAL_REF 1
}
