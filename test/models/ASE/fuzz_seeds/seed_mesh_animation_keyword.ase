*3DSMAX_ASCIIEXPORT	200
*COMMENT "MESH_ANIMATION keyword + all map types on single material"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.0 0.0 0.0
	*SCENE_AMBIENT_STATIC 0.1 0.1 0.1
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "FullMapsMat"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.8 0.6 0.4
		*MATERIAL_SPECULAR 1.0 1.0 1.0
		*MATERIAL_SHINE 0.7
		*MATERIAL_SHINESTRENGTH 0.5
		*MATERIAL_TRANSPARENCY 0.15
		*MATERIAL_SHADING Phong
		*MATERIAL_TWOSIDED
		*MATERIAL_SELFILLUM 0.2
		*MAP_DIFFUSE {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "diffuse.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
			*UVW_ANGLE 0.0
		}
		*MAP_AMBIENT {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.5
			*BITMAP "ambient.tga"
			*UVW_U_OFFSET 0.1
			*UVW_V_OFFSET 0.2
			*UVW_U_TILING 2.0
			*UVW_V_TILING 2.0
			*UVW_ANGLE 0.7854
		}
		*MAP_SPECULAR {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.8
			*BITMAP "specular.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
		}
		*MAP_BUMP {
			*MAP_CLASS "Normal Bump"
			*MAP_AMOUNT 0.3
			*BITMAP "normal.tga"
			*UVW_U_OFFSET 0.0
			*UVW_V_OFFSET 0.0
			*UVW_U_TILING 1.0
			*UVW_V_TILING 1.0
		}
		*MAP_OPACITY {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 1.0
			*BITMAP "opacity.tga"
		}
		*MAP_SELFILLUM {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.6
			*BITMAP "emissive.tga"
		}
		*MAP_SHINESTRENGTH {
			*MAP_CLASS "Bitmap"
			*MAP_AMOUNT 0.7
			*BITMAP "gloss.tga"
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "AnimMeshBox"
	*NODE_TM {
		*NODE_NAME "AnimMeshBox"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*MESH {
		*MESH_NUMVERTEX 8
		*MESH_NUMFACES 6
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 -1.0 -1.0 0.0
			*MESH_VERTEX 1  1.0 -1.0 0.0
			*MESH_VERTEX 2  1.0  1.0 0.0
			*MESH_VERTEX 3 -1.0  1.0 0.0
			*MESH_VERTEX 4 -1.0 -1.0 2.0
			*MESH_VERTEX 5  1.0 -1.0 2.0
			*MESH_VERTEX 6  1.0  1.0 2.0
			*MESH_VERTEX 7 -1.0  1.0 2.0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 1: A: 0 B: 2 C: 3 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
			*MESH_FACE 2: A: 4 B: 6 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 3: A: 4 B: 7 C: 6 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 2 *MESH_MTLID 0
			*MESH_FACE 4: A: 0 B: 4 C: 5 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 0
			*MESH_FACE 5: A: 0 B: 5 C: 1 AB: 1 BC: 1 CA: 0 *MESH_SMOOTHING 3 *MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0 0.0 0.0 0.0
			*MESH_TVERT 1 1.0 0.0 0.0
			*MESH_TVERT 2 1.0 1.0 0.0
			*MESH_TVERT 3 0.0 1.0 0.0
		}
		*MESH_NUMTVFACES 6
		*MESH_TFACELIST {
			*MESH_TFACE 0 0 1 2
			*MESH_TFACE 1 0 2 3
			*MESH_TFACE 2 0 2 1
			*MESH_TFACE 3 0 3 2
			*MESH_TFACE 4 0 3 1
			*MESH_TFACE 5 0 1 2
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 0 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 1 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 2 0.0 0.0 -1.0
			*MESH_FACENORMAL 1 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 0 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 2 0.0 0.0 -1.0
				*MESH_VERTEXNORMAL 3 0.0 0.0 -1.0
		}
		*MESH_ANIMATION {
		}
	}
	*MATERIAL_REF 0
}
