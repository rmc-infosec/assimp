*3DSMAX_ASCIIEXPORT	200
*COMMENT "Scene with only cameras/lights/helpers and NO meshes - exercises SkeletonMeshBuilder path"
*SCENE {
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 100
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
	*SCENE_BACKGROUND_STATIC 0.1 0.1 0.2
	*SCENE_AMBIENT_STATIC 0.05 0.05 0.05
}
*HELPEROBJECT {
	*NODE_NAME "Root"
	*NODE_TM {
		*NODE_NAME "Root"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 0.0
	}
	*TM_ANIMATION {
		*NODE_NAME "Root"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 0.0
			*CONTROL_POS_SAMPLE 1600 1.0 0.0 0.0
			*CONTROL_POS_SAMPLE 3200 2.0 0.0 0.0
		}
		*CONTROL_ROT_TRACK {
			*CONTROL_ROT_SAMPLE 0 0.0 0.0 1.0 0.0
			*CONTROL_ROT_SAMPLE 1600 0.0 0.0 1.0 0.7854
			*CONTROL_ROT_SAMPLE 3200 0.0 0.0 1.0 1.5708
		}
	}
}
*HELPEROBJECT {
	*NODE_NAME "Bone01"
	*NODE_PARENT "Root"
	*NODE_TM {
		*NODE_NAME "Bone01"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 2.0
	}
	*TM_ANIMATION {
		*NODE_NAME "Bone01"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0 0.0 0.0 2.0
			*CONTROL_POS_SAMPLE 1600 0.0 1.0 2.0
			*CONTROL_POS_SAMPLE 3200 0.0 0.0 2.0
		}
	}
}
*HELPEROBJECT {
	*NODE_NAME "Bone02"
	*NODE_PARENT "Bone01"
	*NODE_TM {
		*NODE_NAME "Bone02"
		*INHERIT_POS 1 1 1
		*INHERIT_ROT 1 1 1
		*INHERIT_SCL 1 1 1
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 0.0 0.0 4.0
	}
}
*CAMERAOBJECT {
	*NODE_NAME "SceneCam"
	*CAMERA_TYPE Free
	*NODE_TM {
		*NODE_NAME "SceneCam"
		*TM_ROW0 1.0 0.0 0.0
		*TM_ROW1 0.0 1.0 0.0
		*TM_ROW2 0.0 0.0 1.0
		*TM_ROW3 -10.0 -10.0 5.0
	}
	*CAMERA_SETTINGS {
		*CAMERA_NEAR 0.1
		*CAMERA_FAR 500.0
		*CAMERA_FOV 0.7854
	}
}
*LIGHTOBJECT {
	*NODE_NAME "SceneLight"
	*LIGHT_TYPE Directional
	*NODE_TM {
		*NODE_NAME "SceneLight"
		*TM_ROW0 0.7071 -0.7071 0.0
		*TM_ROW1 0.4082 0.4082 0.8165
		*TM_ROW2 -0.5774 -0.5774 0.5774
		*TM_ROW3 50.0 50.0 50.0
	}
	*LIGHT_SETTINGS {
		*LIGHT_COLOR 1.0 1.0 1.0
		*LIGHT_INTENS 1.0
	}
}
