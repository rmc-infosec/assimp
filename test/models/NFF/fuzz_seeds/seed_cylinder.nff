
# Cylinder and cone primitives
from 0 5 15
at 0 0 0
up 0 1 0
angle 50
resolution 512 512

l 5 10 5

# green cylinder (same radius at both ends)
f 0 1 0 0.7 0.3 30 0 1
tess 3
c
0 0 0 2
0 4 0 2

# red cone (different radii)
f 1 0 0 0.8 0.2 40 0 1
c
5 0 0 3
5 5 0 0

# blue tapered cylinder
f 0 0 1 0.6 0.4 50 0 1
c
-5 0 0 2
-5 6 0 1

# white closed cone (radius 0 at top)
f 1 1 1 0.5 0.5 45 0 1
c
0 0 5 1.5
0 3 5 0
