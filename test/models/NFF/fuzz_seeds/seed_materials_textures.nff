# NFF1 material (f) with textures and shader keyword
from 0 3 10
at 0 0 0
up 0 1 0
angle 55
resolution 512 512
l 5 8 5 1.0 1 1 1
# Material with texture filename after f params
f 0.8 0.8 0.8 0.7 0.2 30 0 1.0 brick.png
p 4
-3 0 -3
3 0 -3
3 0 3
-3 0 3
# Material with specular and refraction
f 0.9 0.1 0.1 0.3 0.7 100 0.5 1.5
s 0 1 0 1
# Transparent material with high transmittance
f 0.2 0.2 0.9 0.2 0.3 50 0.8 1.33
s 2 1 2 0.5
# Material with ambient value (numeric after refraction)
f 0.5 0.9 0.5 0.6 0.4 40 0 1.0 0.3
pp 3
-2 0 2 0 0 1
2 0 2 0 0 1
0 2 2 0 0 1
# Use shader keyword for texture
shader marble_floor.tga
p 4
-5 -0.01 -5
5 -0.01 -5
5 -0.01 5
-5 -0.01 5
# Another shader keyword
shader wood_panel.bmp
p 3
-4 0 -4
-4 3 -4
-2 0 -4
# Reset to plain material (no texture)
f 1 1 0 0.5 0.5 20 0 1.0
s -2 1 -2 0.7
