<?xml version="1.0"?>
<irr_scene>
  <attributes>
    <string name="Name" value="root"/>
  </attributes>
  <node type="mesh">
    <attributes>
      <string name="Name" value="AnimatedBox"/>
      <string name="Mesh" value="box.irrmesh"/>
      <vector3d name="Position" value="0, 0, 0"/>
      <vector3d name="Rotation" value="0, 0, 0"/>
      <vector3d name="Scale" value="1, 1, 1"/>
      <bool name="Visible" value="true"/>
    </attributes>
    <animators>
      <attributes>
        <string name="Type" value="flyCircle"/>
        <vector3d name="Center" value="0, 0, 0"/>
        <float name="Radius" value="5"/>
        <float name="Speed" value="0.001"/>
        <vector3d name="Direction" value="0, 1, 0"/>
        <float name="StartPosition" value="0"/>
        <float name="RadiusEllipsoid" value="5"/>
      </attributes>
    </animators>
    <animators>
      <attributes>
        <string name="Type" value="rotation"/>
        <vector3d name="Rotation" value="0, 45, 0"/>
      </attributes>
    </animators>
  </node>
  <node type="mesh">
    <attributes>
      <string name="Name" value="FlyStraight"/>
      <string name="Mesh" value="box.irrmesh"/>
      <vector3d name="Position" value="5, 0, 0"/>
      <vector3d name="Rotation" value="0, 0, 0"/>
      <vector3d name="Scale" value="0.5, 0.5, 0.5"/>
      <bool name="Visible" value="true"/>
    </attributes>
    <animators>
      <attributes>
        <string name="Type" value="flyStraight"/>
        <vector3d name="Start" value="0, 0, 0"/>
        <vector3d name="End" value="10, 5, 10"/>
        <int name="TimeForWay" value="3000"/>
        <bool name="Loop" value="true"/>
        <bool name="PingPong" value="true"/>
      </attributes>
    </animators>
  </node>
  <node type="skyBox">
    <attributes>
      <string name="Name" value="Sky"/>
      <bool name="Visible" value="true"/>
    </attributes>
    <materials>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
      <attributes>
        <enum name="Type" value="solid"/>
        <color name="Diffuse" value="ffffffff"/>
      </attributes>
    </materials>
  </node>
</irr_scene>
