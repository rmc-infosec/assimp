<?xml version="1.0"?>
<skeleton>
    <bones>
        <bone id="0" name="Root">
            <position x="0" y="0" z="0"/>
            <rotation angle="0">
                <axis x="0" y="1" z="0"/>
            </rotation>
        </bone>
        <bone id="1" name="Spine">
            <position x="0" y="1" z="0"/>
            <rotation angle="0">
                <axis x="0" y="1" z="0"/>
            </rotation>
        </bone>
        <bone id="2" name="Head">
            <position x="0" y="1" z="0"/>
            <rotation angle="0">
                <axis x="0" y="1" z="0"/>
            </rotation>
        </bone>
    </bones>
    <bonehierarchy>
        <boneparent bone="Spine" parent="Root"/>
        <boneparent bone="Head" parent="Spine"/>
    </bonehierarchy>
    <animations>
        <animation name="walk" length="1.0">
            <tracks>
                <track bone="Root">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                        <keyframe time="0.5">
                            <translate x="0" y="0.1" z="0.5"/>
                            <rotate angle="0.1">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0" z="1.0"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                    </keyframes>
                </track>
                <track bone="Spine">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="0.5">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0.2">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                    </keyframes>
                </track>
            </tracks>
        </animation>
    </animations>
</skeleton>
