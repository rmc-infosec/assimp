<?xml version="1.0" encoding="UTF-8"?>
<skeleton blendmode="average">
    <bones>
        <bone id="0" name="Root">
            <position x="0" y="0" z="0"/>
            <rotation angle="0">
                <axis x="0" y="1" z="0"/>
            </rotation>
            <scale factor="1"/>
        </bone>
        <bone id="1" name="Spine">
            <position x="0" y="1" z="0"/>
            <rotation angle="0">
                <axis x="0" y="1" z="0"/>
            </rotation>
            <scale x="1" y="1" z="1"/>
        </bone>
        <bone id="2" name="Chest">
            <position x="0" y="1" z="0"/>
            <rotation angle="0.1">
                <axis x="1" y="0" z="0"/>
            </rotation>
        </bone>
        <bone id="3" name="ArmL">
            <position x="-0.5" y="0.5" z="0"/>
            <rotation angle="0.3">
                <axis x="0" y="0" z="1"/>
            </rotation>
            <scale x="0.9" y="0.9" z="0.9"/>
        </bone>
        <bone id="4" name="ArmR">
            <position x="0.5" y="0.5" z="0"/>
            <rotation angle="-0.3">
                <axis x="0" y="0" z="1"/>
            </rotation>
            <scale factor="0.95"/>
        </bone>
    </bones>
    <bonehierarchy>
        <boneparent bone="Spine" parent="Root"/>
        <boneparent bone="Chest" parent="Spine"/>
        <boneparent bone="ArmL" parent="Chest"/>
        <boneparent bone="ArmR" parent="Chest"/>
    </bonehierarchy>
    <animations>
        <animation name="Walk" length="1.0">
            <tracks>
                <track bone="Root">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                        <keyframe time="0.5">
                            <translate x="0" y="0.1" z="0.5"/>
                            <rotate angle="0.05">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0" z="1"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                            <scale x="1" y="1" z="1"/>
                        </keyframe>
                    </keyframes>
                </track>
                <track bone="Spine">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="0.5">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0.1">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                    </keyframes>
                </track>
                <track bone="ArmL">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0.2">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="0.5">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="-0.2">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0.2">
                                <axis x="1" y="0" z="0"/>
                            </rotate>
                        </keyframe>
                    </keyframes>
                </track>
            </tracks>
        </animation>
        <animation name="Idle" length="2.0">
            <tracks>
                <track bone="Chest">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="1.0">
                            <translate x="0" y="0.05" z="0"/>
                            <rotate angle="0.02">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="2.0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="1" z="0"/>
                            </rotate>
                        </keyframe>
                    </keyframes>
                </track>
                <track bone="ArmR">
                    <keyframes>
                        <keyframe time="0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="0" z="1"/>
                            </rotate>
                        </keyframe>
                        <keyframe time="2.0">
                            <translate x="0" y="0" z="0"/>
                            <rotate angle="0">
                                <axis x="0" y="0" z="1"/>
                            </rotate>
                        </keyframe>
                    </keyframes>
                </track>
            </tracks>
        </animation>
    </animations>
</skeleton>
