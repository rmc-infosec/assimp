<skeleton blendmode="cumulative">
  <bones>
    <bone id="0" name="Root">
      <position x="0" y="0" z="0"/>
      <rotation angle="0">
        <axis x="1" y="0" z="0"/>
      </rotation>
      <scale x="1" y="1" z="1"/>
    </bone>
    <bone id="1" name="Child">
      <position x="0" y="1" z="0"/>
      <rotation angle="0">
        <axis x="1" y="0" z="0"/>
      </rotation>
      <scale x="2" y="2" z="2"/>
    </bone>
  </bones>
  <bonehierarchy>
    <boneparent bone="Child" parent="Root"/>
  </bonehierarchy>
  <animations>
    <animation name="ScaleAnim" length="2.0">
      <tracks>
        <track bone="Root">
          <keyframes>
            <keyframe time="0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="1" y="0" z="0"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
            <keyframe time="1.0">
              <translate x="0" y="1" z="0"/>
              <rotate angle="0.5">
                <axis x="0" y="1" z="0"/>
              </rotate>
              <scale x="2" y="2" z="2"/>
            </keyframe>
            <keyframe time="2.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="1" y="0" z="0"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
          </keyframes>
        </track>
        <track bone="Child">
          <keyframes>
            <keyframe time="0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="0" z="1"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
            <keyframe time="2.0">
              <translate x="1" y="0" z="0"/>
              <rotate angle="1.57">
                <axis x="0" y="0" z="1"/>
              </rotate>
              <scale x="0.5" y="0.5" z="0.5"/>
            </keyframe>
          </keyframes>
        </track>
      </tracks>
    </animation>
  </animations>
</skeleton>
