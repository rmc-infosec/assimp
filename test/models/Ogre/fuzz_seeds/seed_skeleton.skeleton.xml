<skeleton blendmode="average">
  <bones>
    <bone id="0" name="Root">
      <position x="0" y="0" z="0"/>
      <rotation angle="0">
        <axis x="0" y="1" z="0"/>
      </rotation>
      <scale x="1" y="1" z="1"/>
    </bone>
    <bone id="1" name="Spine">
      <position x="0" y="1" z="0"/>
      <rotation angle="0.1">
        <axis x="1" y="0" z="0"/>
      </rotation>
      <scale factor="1.0"/>
    </bone>
    <bone id="2" name="Head">
      <position x="0" y="0.8" z="0"/>
      <rotation angle="0">
        <axis x="0" y="1" z="0"/>
      </rotation>
      <scale x="0.9" y="1.1"/>
    </bone>
    <bone id="3" name="ArmL">
      <position x="-0.5" y="0.7" z="0"/>
      <rotation angle="0.785">
        <axis x="0" y="0" z="1"/>
      </rotation>
    </bone>
    <bone id="4" name="ArmR">
      <position x="0.5" y="0.7" z="0"/>
      <rotation angle="-0.785">
        <axis x="0" y="0" z="1"/>
      </rotation>
      <scale z="1.2"/>
    </bone>
  </bones>
  <bonehierarchy>
    <boneparent bone="Spine" parent="Root"/>
    <boneparent bone="Head" parent="Spine"/>
    <boneparent bone="ArmL" parent="Spine"/>
    <boneparent bone="ArmR" parent="Spine"/>
  </bonehierarchy>
  <animations>
    <animation name="wave" length="2.0">
      <tracks>
        <track bone="Root">
          <keyframes>
            <keyframe time="0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="1" z="0"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
            <keyframe time="1.0">
              <translate x="0" y="0.2" z="0"/>
              <rotate angle="0.1">
                <axis x="0" y="1" z="0"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
            <keyframe time="2.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="1" z="0"/>
              </rotate>
              <scale x="1" y="1" z="1"/>
            </keyframe>
          </keyframes>
        </track>
        <track bone="ArmL">
          <keyframes>
            <keyframe time="0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="0" z="1"/>
              </rotate>
            </keyframe>
            <keyframe time="0.5">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0.3">
                <axis x="0" y="0" z="0"/>
              </rotate>
            </keyframe>
            <keyframe time="1.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="1.57">
                <axis x="0" y="0" z="1"/>
              </rotate>
            </keyframe>
            <keyframe time="2.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="0" z="0"/>
              </rotate>
            </keyframe>
          </keyframes>
        </track>
        <track bone="Head">
          <keyframes>
            <keyframe time="0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="1" z="0"/>
              </rotate>
            </keyframe>
            <keyframe time="1.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0.3">
                <axis x="0" y="1" z="0"/>
              </rotate>
            </keyframe>
            <keyframe time="2.0">
              <translate x="0" y="0" z="0"/>
              <rotate angle="0">
                <axis x="0" y="1" z="0"/>
              </rotate>
            </keyframe>
          </keyframes>
        </track>
      </tracks>
    </animation>
  </animations>
</skeleton>
