<mesh>
  <submeshes>
    <submesh material="Mat" usesharedvertices="false" operationtype="triangle_list">
      <faces count="1">
        <face v1="0" v2="1" v3="2"/>
      </faces>
      <geometry vertexcount="3">
        <vertexbuffer positions="true" normals="true">
          <vertex>
            <position x="0" y="0" z="0"/>
            <normal x="0" y="0" z="1"/>
          </vertex>
          <vertex>
            <position x="1" y="0" z="0"/>
            <normal x="0" y="0" z="1"/>
          </vertex>
          <vertex>
            <position x="0" y="1" z="0"/>
            <normal x="0" y="0" z="1"/>
          </vertex>
        </vertexbuffer>
      </geometry>
    </submesh>
  </submeshes>
  <poses>
    <pose target="submesh" index="0" name="Smile">
      <poseoffset index="0" x="0.1" y="0" z="0"/>
      <poseoffset index="1" x="0" y="0.1" z="0"/>
      <poseoffset index="2" x="0" y="0" z="0.1"/>
    </pose>
    <pose target="submesh" index="0" name="Frown">
      <poseoffset index="0" x="-0.1" y="0" z="0"/>
      <poseoffset index="1" x="0" y="-0.1" z="0"/>
      <poseoffset index="2" x="0" y="0" z="-0.1"/>
    </pose>
  </poses>
  <animations>
    <animation name="PoseAnim" length="1.0">
      <tracks>
        <track type="pose" target="submesh" index="0">
          <keyframes>
            <keyframe time="0">
              <poseref poseindex="0" influence="0"/>
              <poseref poseindex="1" influence="1"/>
            </keyframe>
            <keyframe time="0.5">
              <poseref poseindex="0" influence="1"/>
              <poseref poseindex="1" influence="0"/>
            </keyframe>
            <keyframe time="1.0">
              <poseref poseindex="0" influence="0"/>
              <poseref poseindex="1" influence="1"/>
            </keyframe>
          </keyframes>
        </track>
      </tracks>
    </animation>
  </animations>
</mesh>
