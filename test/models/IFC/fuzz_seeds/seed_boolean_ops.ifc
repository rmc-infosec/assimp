ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('seed.ifc','2024-01-01',(''),(''),'','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCORGANIZATION($,'Fuzz','Boolean ops seed',$,$);
#2=IFCAPPLICATION(#1,'1.0','FuzzBool','FuzzBool');
#3=IFCOWNERHISTORY(#1,#2,$,.NOCHANGE.,$,$,$,0);
#4=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#5=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#6=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#7=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#8=IFCUNITASSIGNMENT((#4,#5,#6,#7));
#9=IFCDIRECTION((1.,0.,0.));
#10=IFCDIRECTION((0.,1.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#13,$);
#15=IFCPROJECT('B001',#3,'BoolOpsProject',$,$,$,$,(#14),#8);
#16=IFCLOCALPLACEMENT($,#13);
#17=IFCSITE('B002',#3,'Site',$,$,#16,$,$,.ELEMENT.,$,$,$,$,$);
#18=IFCRELAGGREGATES('B003',#3,$,$,#15,(#17));
#19=IFCBUILDING('B004',#3,'Building',$,$,#16,$,$,.ELEMENT.,$,$,$);
#20=IFCRELAGGREGATES('B005',#3,$,$,#17,(#19));
#21=IFCBUILDINGSTOREY('B006',#3,'Floor',$,$,#16,$,$,.ELEMENT.,0.);
#22=IFCRELAGGREGATES('B007',#3,$,$,#19,(#21));
#23=IFCAXIS2PLACEMENT2D(#24,#25);
#24=IFCCARTESIANPOINT((0.,0.));
#25=IFCDIRECTION((1.,0.));

/* === Object 1: IfcBooleanClippingResult with chained clipping === */
/* Wall base: 5m x 0.3m extruded to 3m */
#100=IFCRECTANGLEPROFILEDEF(.AREA.,'wallprof',#23,5.0,0.3);
#101=IFCEXTRUDEDAREASOLID(#100,#13,#11,3.0);
/* First clip: horizontal plane at z=2.5 from top */
#102=IFCCARTESIANPOINT((0.,0.,2.5));
#103=IFCDIRECTION((0.,0.,1.));
#104=IFCAXIS2PLACEMENT3D(#102,#103,#9);
#105=IFCPLANE(#104);
#106=IFCHALFSPACESOLID(#105,.T.);
#107=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#101,#106);
/* Second clip: diagonal plane for sloped top */
#108=IFCCARTESIANPOINT((2.5,0.,2.0));
#109=IFCDIRECTION((1.,0.,1.));
#110=IFCAXIS2PLACEMENT3D(#108,#109,#10);
#111=IFCPLANE(#110);
#112=IFCHALFSPACESOLID(#111,.F.);
/* Chain: first operand is already a BooleanClippingResult */
#113=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#107,#112);
#114=IFCSHAPEREPRESENTATION(#14,'Body','CSG',(#113));
#115=IFCPRODUCTDEFINITIONSHAPE($,$,(#114));
#116=IFCWALLSTANDARDCASE('CW01',#3,'ChainClippedWall',$,$,#16,#115,$);

/* === Object 2: IfcBooleanResult with IfcExtrudedAreaSolid as second operand === */
/* This triggers ProcessBooleanExtrudedAreaSolidDifference */
#200=IFCRECTANGLEPROFILEDEF(.AREA.,'slab',#23,4.0,4.0);
#201=IFCEXTRUDEDAREASOLID(#200,#13,#11,0.3);
/* Hole: circle extruded through the slab */
#202=IFCCIRCLEPROFILEDEF(.AREA.,'hole',#23,0.5);
#203=IFCCARTESIANPOINT((1.0,1.0,0.));
#204=IFCAXIS2PLACEMENT3D(#203,#11,#9);
#205=IFCEXTRUDEDAREASOLID(#202,#204,#11,0.5);
#206=IFCBOOLEANRESULT(.DIFFERENCE.,#201,#205);
#207=IFCSHAPEREPRESENTATION(#14,'Body','CSG',(#206));
#208=IFCPRODUCTDEFINITIONSHAPE($,$,(#207));
#209=IFCCARTESIANPOINT((0.,0.,3.0));
#210=IFCAXIS2PLACEMENT3D(#209,#11,#9);
#211=IFCLOCALPLACEMENT(#16,#210);
#212=IFCSLAB('SL01',#3,'SlabWithHole',$,$,#211,#208,$,.FLOOR.);

/* === Object 3: IfcRelVoidsElement with real window opening geometry === */
/* Wall with a proper opening element containing an extruded window void */
#300=IFCCARTESIANPOINT((0.,0.));
#301=IFCCARTESIANPOINT((6.,0.));
#302=IFCCARTESIANPOINT((6.,0.25));
#303=IFCCARTESIANPOINT((0.,0.25));
#304=IFCPOLYLINE((#300,#301,#302,#303,#300));
#305=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'wallcurve',#304);
#306=IFCEXTRUDEDAREASOLID(#305,#13,#11,3.0);
#307=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#306));
#308=IFCPRODUCTDEFINITIONSHAPE($,$,(#307));
#309=IFCCARTESIANPOINT((0.,5.,0.));
#310=IFCAXIS2PLACEMENT3D(#309,#11,#9);
#311=IFCLOCALPLACEMENT(#16,#310);
#312=IFCWALLSTANDARDCASE('VW02',#3,'WallWithVoids',$,$,#311,#308,$);
/* Opening 1: window */
#320=IFCRECTANGLEPROFILEDEF(.AREA.,'winprof',#23,1.2,0.25);
#321=IFCEXTRUDEDAREASOLID(#320,#13,#11,1.4);
#322=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#321));
#323=IFCPRODUCTDEFINITIONSHAPE($,$,(#322));
#324=IFCCARTESIANPOINT((1.5,0.,0.9));
#325=IFCAXIS2PLACEMENT3D(#324,#11,#9);
#326=IFCLOCALPLACEMENT(#311,#325);
#327=IFCOPENINGELEMENT('OE02',#3,'WindowOpening1',$,$,#326,#323,$);
#328=IFCRELVOIDSELEMENT('RV02',#3,$,$,#312,#327);
#329=IFCWINDOW('W01',#3,'Window1',$,$,#326,$,$,1.4,1.2);
#330=IFCRELFILLSELEMENT('RF02',#3,$,$,#327,#329);
/* Opening 2: door */
#340=IFCRECTANGLEPROFILEDEF(.AREA.,'doorprof',#23,0.9,0.25);
#341=IFCEXTRUDEDAREASOLID(#340,#13,#11,2.1);
#342=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#341));
#343=IFCPRODUCTDEFINITIONSHAPE($,$,(#342));
#344=IFCCARTESIANPOINT((4.0,0.,0.));
#345=IFCAXIS2PLACEMENT3D(#344,#11,#9);
#346=IFCLOCALPLACEMENT(#311,#345);
#347=IFCOPENINGELEMENT('OE03',#3,'DoorOpening',$,$,#346,#343,$);
#348=IFCRELVOIDSELEMENT('RV03',#3,$,$,#312,#347);
#349=IFCDOOR('D01',#3,'Door1',$,$,#346,$,$,2.1,0.9);
#350=IFCRELFILLSELEMENT('RF03',#3,$,$,#347,#349);

/* === Object 4: PolygonalBoundedHalfSpace with non-axis-aligned boundary === */
/* Exercises ProcessPolygonalBoundedBooleanHalfSpaceDifference deeply */
#400=IFCRECTANGLEPROFILEDEF(.AREA.,'block',#23,2.0,2.0);
#401=IFCEXTRUDEDAREASOLID(#400,#13,#11,2.0);
#402=IFCCARTESIANPOINT((0.,0.,1.0));
#403=IFCDIRECTION((0.5,0.,1.));
#404=IFCAXIS2PLACEMENT3D(#402,#403,#9);
#405=IFCPLANE(#404);
/* Pentagonal boundary polygon (not just rectangular) */
#406=IFCCARTESIANPOINT((-0.5,-0.5));
#407=IFCCARTESIANPOINT((0.5,-0.5));
#408=IFCCARTESIANPOINT((0.8,0.));
#409=IFCCARTESIANPOINT((0.5,0.5));
#410=IFCCARTESIANPOINT((-0.5,0.5));
#411=IFCPOLYLINE((#406,#407,#408,#409,#410,#406));
#412=IFCAXIS2PLACEMENT3D(#402,$,$);
#413=IFCPOLYGONALBOUNDEDHALFSPACE(#405,.T.,#412,#411);
#414=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#401,#413);
#415=IFCSHAPEREPRESENTATION(#14,'Body','CSG',(#414));
#416=IFCPRODUCTDEFINITIONSHAPE($,$,(#415));
#417=IFCCARTESIANPOINT((8.,0.,0.));
#418=IFCAXIS2PLACEMENT3D(#417,#11,#9);
#419=IFCLOCALPLACEMENT(#16,#418);
#420=IFCBUILDINGELEMENTPROXY('PB01',#3,'PolyBoundClip',$,$,#419,#416,$,$);

#500=IFCRELCONTAINEDINSPATIALSTRUCTURE('RC01',#3,$,$,(#116,#212,#312,#420),#21);
ENDSEC;
END-ISO-10303-21;
