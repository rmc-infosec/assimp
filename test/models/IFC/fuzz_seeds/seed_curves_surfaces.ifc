ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('seed.ifc','2024-01-01',(''),(''),'','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCORGANIZATION($,'Fuzz','Curves surfaces seed',$,$);
#2=IFCAPPLICATION(#1,'1.0','FuzzCurve','FuzzCurve');
#3=IFCOWNERHISTORY(#1,#2,$,.NOCHANGE.,$,$,$,0);
#4=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#5=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#6=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#7=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#8=IFCUNITASSIGNMENT((#4,#5,#6,#7));
#9=IFCDIRECTION((1.,0.,0.));
#10=IFCDIRECTION((0.,1.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#13,$);
#15=IFCPROJECT('C001',#3,'CurveProject',$,$,$,$,(#14),#8);
#16=IFCLOCALPLACEMENT($,#13);
#17=IFCSITE('C002',#3,'Site',$,$,#16,$,$,.ELEMENT.,$,$,$,$,$);
#18=IFCRELAGGREGATES('C003',#3,$,$,#15,(#17));
#19=IFCBUILDING('C004',#3,'Building',$,$,#16,$,$,.ELEMENT.,$,$,$);
#20=IFCRELAGGREGATES('C005',#3,$,$,#17,(#19));
#21=IFCBUILDINGSTOREY('C006',#3,'Floor',$,$,#16,$,$,.ELEMENT.,0.);
#22=IFCRELAGGREGATES('C007',#3,$,$,#19,(#21));
#23=IFCAXIS2PLACEMENT2D(#24,#25);
#24=IFCCARTESIANPOINT((0.,0.));
#25=IFCDIRECTION((1.,0.));

/* === Object 1: IfcTrimmedCurve with parametric trim on circle === */
#100=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#101=IFCCIRCLE(#100,1.0);
#102=IFCTRIMMEDCURVE(#101,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(3.14159)),.T.,.PARAMETER.);
#103=IFCARBITRARYOPENPROFILEDEF(.CURVE.,'trimcirc',#102);
#104=IFCEXTRUDEDAREASOLID(#103,#13,#11,1.0);
#105=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#104));
#106=IFCPRODUCTDEFINITIONSHAPE($,$,(#105));
#107=IFCBUILDINGELEMENTPROXY('TC01',#3,'TrimCircExtrude',$,$,#16,#106,$,$);

/* === Object 2: IfcTrimmedCurve with cartesian point trim on ellipse === */
#110=IFCELLIPSE(#100,2.0,1.0);
#111=IFCCARTESIANPOINT((2.,0.,0.));
#112=IFCCARTESIANPOINT((0.,1.,0.));
#113=IFCTRIMMEDCURVE(#110,(#111),(#112),.T.,.CARTESIAN.);
#114=IFCARBITRARYOPENPROFILEDEF(.CURVE.,'trimellipse',#113);
#115=IFCEXTRUDEDAREASOLID(#114,#13,#11,0.5);
#116=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#115));
#117=IFCPRODUCTDEFINITIONSHAPE($,$,(#116));
#118=IFCCARTESIANPOINT((5.,0.,0.));
#119=IFCAXIS2PLACEMENT3D(#118,#11,#9);
#120=IFCLOCALPLACEMENT(#16,#119);
#121=IFCBUILDINGELEMENTPROXY('TC02',#3,'TrimEllipseExtrude',$,$,#120,#117,$,$);

/* === Object 3: IfcShellBasedSurfaceModel === */
#150=IFCCARTESIANPOINT((0.,0.,0.));
#151=IFCCARTESIANPOINT((1.,0.,0.));
#152=IFCCARTESIANPOINT((1.,1.,0.));
#153=IFCCARTESIANPOINT((0.,1.,0.));
#154=IFCPOLYLOOP((#150,#151,#152,#153));
#155=IFCFACEOUTERBOUND(#154,.T.);
#156=IFCFACE((#155));
#157=IFCCARTESIANPOINT((0.,0.,0.));
#158=IFCCARTESIANPOINT((0.,1.,0.));
#159=IFCCARTESIANPOINT((0.,1.,1.));
#160=IFCCARTESIANPOINT((0.,0.,1.));
#161=IFCPOLYLOOP((#157,#158,#159,#160));
#162=IFCFACEOUTERBOUND(#161,.T.);
#163=IFCFACE((#162));
#164=IFCCARTESIANPOINT((1.,0.,0.));
#165=IFCCARTESIANPOINT((1.,1.,0.));
#166=IFCCARTESIANPOINT((1.,1.,1.));
#167=IFCCARTESIANPOINT((1.,0.,1.));
#168=IFCPOLYLOOP((#164,#165,#166,#167));
#169=IFCFACEOUTERBOUND(#168,.T.);
#170=IFCFACE((#169));
#171=IFCOPENSHELL((#156,#163,#170));
#172=IFCSHELLBASEDSURFACEMODEL((#171));
#173=IFCSHAPEREPRESENTATION(#14,'Body','SurfaceModel',(#172));
#174=IFCPRODUCTDEFINITIONSHAPE($,$,(#173));
#175=IFCCARTESIANPOINT((15.,0.,0.));
#176=IFCAXIS2PLACEMENT3D(#175,#11,#9);
#177=IFCLOCALPLACEMENT(#16,#176);
#178=IFCBUILDINGELEMENTPROXY('SH01',#3,'ShellSurface',$,$,#177,#174,$,$);

/* === Object 4: IfcArbitraryProfileDefWithVoids (profile with inner holes) === */
#200=IFCCARTESIANPOINT((0.,0.));
#201=IFCCARTESIANPOINT((3.,0.));
#202=IFCCARTESIANPOINT((3.,3.));
#203=IFCCARTESIANPOINT((0.,3.));
#204=IFCPOLYLINE((#200,#201,#202,#203,#200));
#205=IFCCARTESIANPOINT((1.,1.));
#206=IFCCARTESIANPOINT((2.,1.));
#207=IFCCARTESIANPOINT((2.,2.));
#208=IFCCARTESIANPOINT((1.,2.));
#209=IFCPOLYLINE((#205,#206,#207,#208,#205));
#210=IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA.,'voidprof',#204,(#209));
#211=IFCEXTRUDEDAREASOLID(#210,#13,#11,1.0);
#212=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#211));
#213=IFCPRODUCTDEFINITIONSHAPE($,$,(#212));
#214=IFCCARTESIANPOINT((20.,0.,0.));
#215=IFCAXIS2PLACEMENT3D(#214,#11,#9);
#216=IFCLOCALPLACEMENT(#16,#215);
#217=IFCBUILDINGELEMENTPROXY('VP01',#3,'VoidProfile',$,$,#216,#213,$,$);

/* === Object 5: IfcFaceBasedSurfaceModel with inner bound === */
#250=IFCCARTESIANPOINT((0.,0.,0.));
#251=IFCCARTESIANPOINT((2.,0.,0.));
#252=IFCCARTESIANPOINT((2.,2.,0.));
#253=IFCCARTESIANPOINT((0.,2.,0.));
#254=IFCPOLYLOOP((#250,#251,#252,#253));
#255=IFCFACEOUTERBOUND(#254,.T.);
#256=IFCFACE((#255));
#257=IFCCARTESIANPOINT((0.,0.,1.));
#258=IFCCARTESIANPOINT((2.,0.,1.));
#259=IFCCARTESIANPOINT((2.,2.,1.));
#260=IFCCARTESIANPOINT((0.,2.,1.));
#261=IFCPOLYLOOP((#257,#258,#259,#260));
#262=IFCFACEOUTERBOUND(#261,.T.);
#263=IFCCARTESIANPOINT((0.5,0.5,1.));
#264=IFCCARTESIANPOINT((1.5,0.5,1.));
#265=IFCCARTESIANPOINT((1.5,1.5,1.));
#266=IFCCARTESIANPOINT((0.5,1.5,1.));
#267=IFCPOLYLOOP((#263,#264,#265,#266));
#268=IFCFACEBOUND(#267,.T.);
#269=IFCFACE((#262,#268));
#270=IFCCONNECTEDFACESET((#256,#269));
#271=IFCFACEBASEDSURFACEMODEL((#270));
#272=IFCSHAPEREPRESENTATION(#14,'Body','SurfaceModel',(#271));
#273=IFCPRODUCTDEFINITIONSHAPE($,$,(#272));
#274=IFCCARTESIANPOINT((25.,0.,0.));
#275=IFCAXIS2PLACEMENT3D(#274,#11,#9);
#276=IFCLOCALPLACEMENT(#16,#275);
#277=IFCBUILDINGELEMENTPROXY('FB01',#3,'FaceBasedSurf',$,$,#276,#273,$,$);

/* === Object 6: TrimmedCurve with SenseAgreement=.F. (reverse sense) === */
#280=IFCCIRCLE(#100,1.5);
#281=IFCTRIMMEDCURVE(#280,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(3.14159)),.F.,.PARAMETER.);
#282=IFCARBITRARYOPENPROFILEDEF(.CURVE.,'revtrim',#281);
#283=IFCEXTRUDEDAREASOLID(#282,#13,#11,0.5);
#284=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#283));
#285=IFCPRODUCTDEFINITIONSHAPE($,$,(#284));
#286=IFCCARTESIANPOINT((30.,0.,0.));
#287=IFCAXIS2PLACEMENT3D(#286,#11,#9);
#288=IFCLOCALPLACEMENT(#16,#287);
#289=IFCBUILDINGELEMENTPROXY('TC03',#3,'ReverseTrimExtrude',$,$,#288,#285,$,$);

#500=IFCRELCONTAINEDINSPATIALSTRUCTURE('RC01',#3,$,$,(#107,#121,#178,#217,#277,#289),#21);
ENDSEC;
END-ISO-10303-21;
