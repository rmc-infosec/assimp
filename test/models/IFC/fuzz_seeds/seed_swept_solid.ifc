ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('seed.ifc','2024-01-01',(''),(''),'','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCORGANIZATION($,'Fuzz','Swept solid seed',$,$);
#2=IFCAPPLICATION(#1,'1.0','FuzzSwept','FuzzSwept');
#3=IFCOWNERHISTORY(#1,#2,$,.NOCHANGE.,$,$,$,0);
#4=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#5=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#6=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#7=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#8=IFCUNITASSIGNMENT((#4,#5,#6,#7));
#9=IFCDIRECTION((1.,0.,0.));
#10=IFCDIRECTION((0.,1.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#13,$);
#15=IFCPROJECT('S001',#3,'SweptProject',$,$,$,$,(#14),#8);
#16=IFCLOCALPLACEMENT($,#13);
#17=IFCSITE('S002',#3,'Site',$,$,#16,$,$,.ELEMENT.,$,$,$,$,$);
#18=IFCRELAGGREGATES('S003',#3,$,$,#15,(#17));
#19=IFCBUILDING('S004',#3,'Building',$,$,#16,$,$,.ELEMENT.,$,$,$);
#20=IFCRELAGGREGATES('S005',#3,$,$,#17,(#19));
#21=IFCBUILDINGSTOREY('S006',#3,'Floor',$,$,#16,$,$,.ELEMENT.,0.);
#22=IFCRELAGGREGATES('S007',#3,$,$,#19,(#21));
#23=IFCAXIS2PLACEMENT2D(#24,#25);
#24=IFCCARTESIANPOINT((0.,0.));
#25=IFCDIRECTION((1.,0.));

/* === Object 1: IfcSweptDiskSolid with IfcCompositeCurve directrix === */
/* Exercises CompositeCurve + SweptDiskSolid code paths */
/* Segment 1: a line from origin to (2,0,0) */
#100=IFCCARTESIANPOINT((0.,0.,0.));
#101=IFCCARTESIANPOINT((2.,0.,0.));
#102=IFCPOLYLINE((#100,#101));
#103=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#102);
/* Segment 2: a line from (2,0,0) to (3,1,0.5) */
#104=IFCCARTESIANPOINT((3.,1.,0.5));
#105=IFCPOLYLINE((#101,#104));
#106=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#105);
/* Segment 3: a line from (3,1,0.5) to (4,0,1) */
#107=IFCCARTESIANPOINT((4.,0.,1.));
#108=IFCPOLYLINE((#104,#107));
#109=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#108);
/* Composite curve joining segments */
#110=IFCCOMPOSITECURVE((#103,#106,#109),.F.);
/* Swept disk along composite curve */
#111=IFCSWEPTDISKSOLID(#110,0.1,$,0.0,1.0);
#112=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#111));
#113=IFCPRODUCTDEFINITIONSHAPE($,$,(#112));
#114=IFCBUILDINGELEMENTPROXY('SD01',#3,'SweptDiskComposite',$,$,#16,#113,$,$);

/* === Object 2: IfcRevolvedAreaSolid with full revolution === */
/* Exercises ProcessRevolvedAreaSolid with AREA profile and full 2*PI angle */
#200=IFCCARTESIANPOINT((0.5,0.));
#201=IFCCARTESIANPOINT((0.8,0.));
#202=IFCCARTESIANPOINT((0.8,1.));
#203=IFCCARTESIANPOINT((0.5,1.));
#204=IFCPOLYLINE((#200,#201,#202,#203,#200));
#205=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'revolveprof',#204);
#206=IFCAXIS1PLACEMENT(#12,#11);
#207=IFCREVOLVEDAREASOLID(#205,#13,#206,6.2831853);
#208=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#207));
#209=IFCPRODUCTDEFINITIONSHAPE($,$,(#208));
#210=IFCCARTESIANPOINT((6.,0.,0.));
#211=IFCAXIS2PLACEMENT3D(#210,#11,#9);
#212=IFCLOCALPLACEMENT(#16,#211);
#213=IFCBUILDINGELEMENTPROXY('RV01',#3,'FullRevolve',$,$,#212,#209,$,$);

/* === Object 3: IfcRevolvedAreaSolid with partial revolution (90 degrees) === */
/* Exercises the has_area code path with partial angle */
#220=IFCCIRCLEPROFILEDEF(.AREA.,'circprof',#23,0.3);
#221=IFCAXIS1PLACEMENT(#12,#10);
#222=IFCREVOLVEDAREASOLID(#220,#13,#221,1.5707963);
#223=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#222));
#224=IFCPRODUCTDEFINITIONSHAPE($,$,(#223));
#225=IFCCARTESIANPOINT((10.,0.,0.));
#226=IFCAXIS2PLACEMENT3D(#225,#11,#9);
#227=IFCLOCALPLACEMENT(#16,#226);
#228=IFCBUILDINGELEMENTPROXY('RV02',#3,'PartialRevolve',$,$,#227,#224,$,$);

/* === Object 4: IfcSweptDiskSolid with trimmed circle directrix === */
/* Exercises TrimmedCurve with parametric trim on a circle */
#300=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#301=IFCCIRCLE(#300,2.0);
#302=IFCTRIMMEDCURVE(#301,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(4.71238)),.T.,.PARAMETER.);
#303=IFCSWEPTDISKSOLID(#302,0.08,$,0.0,1.0);
#304=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#303));
#305=IFCPRODUCTDEFINITIONSHAPE($,$,(#304));
#306=IFCCARTESIANPOINT((15.,0.,0.));
#307=IFCAXIS2PLACEMENT3D(#306,#11,#9);
#308=IFCLOCALPLACEMENT(#16,#307);
#309=IFCBUILDINGELEMENTPROXY('SD02',#3,'SweptDiskTrimmedCircle',$,$,#308,#305,$,$);

/* === Object 5: IfcSweptDiskSolid with inner radius === */
/* Exercises the InnerRadius optional parameter */
#350=IFCCARTESIANPOINT((0.,0.,0.));
#351=IFCCARTESIANPOINT((0.,0.,1.));
#352=IFCCARTESIANPOINT((1.,0.,2.));
#353=IFCCARTESIANPOINT((2.,0.,2.));
#354=IFCPOLYLINE((#350,#351,#352,#353));
#355=IFCSWEPTDISKSOLID(#354,0.15,0.05,0.0,1.0);
#356=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#355));
#357=IFCPRODUCTDEFINITIONSHAPE($,$,(#356));
#358=IFCCARTESIANPOINT((20.,0.,0.));
#359=IFCAXIS2PLACEMENT3D(#358,#11,#9);
#360=IFCLOCALPLACEMENT(#16,#359);
#361=IFCBUILDINGELEMENTPROXY('SD03',#3,'SweptDiskInner',$,$,#360,#357,$,$);

/* === Object 6: IfcSurfaceOfRevolution === */
/* Exercises surface of revolution as geometric item */
#400=IFCCARTESIANPOINT((0.3,0.,0.));
#401=IFCCARTESIANPOINT((0.5,0.,0.3));
#402=IFCCARTESIANPOINT((0.4,0.,0.6));
#403=IFCCARTESIANPOINT((0.6,0.,1.0));
#404=IFCPOLYLINE((#400,#401,#402,#403));
#405=IFCAXIS1PLACEMENT(#12,#11);
#406=IFCSURFACEOFREVOLUTION(#404,#13,#405);
#407=IFCSHAPEREPRESENTATION(#14,'Body','SurfaceModel',(#406));
#408=IFCPRODUCTDEFINITIONSHAPE($,$,(#407));
#409=IFCCARTESIANPOINT((25.,0.,0.));
#410=IFCAXIS2PLACEMENT3D(#409,#11,#9);
#411=IFCLOCALPLACEMENT(#16,#410);
#412=IFCBUILDINGELEMENTPROXY('SR01',#3,'SurfRevolution',$,$,#411,#408,$,$);

/* === Object 7: IfcSurfaceOfLinearExtrusion === */
#420=IFCCARTESIANPOINT((0.,0.,0.));
#421=IFCCARTESIANPOINT((1.,0.,0.));
#422=IFCCARTESIANPOINT((1.,0.,0.5));
#423=IFCCARTESIANPOINT((0.5,0.,0.8));
#424=IFCPOLYLINE((#420,#421,#422,#423));
#425=IFCVECTOR(#11,2.0);
#426=IFCSURFACEOFLINEAREXTRUSION(#424,#13,#425,1.5);
#427=IFCSHAPEREPRESENTATION(#14,'Body','SurfaceModel',(#426));
#428=IFCPRODUCTDEFINITIONSHAPE($,$,(#427));
#429=IFCCARTESIANPOINT((30.,0.,0.));
#430=IFCAXIS2PLACEMENT3D(#429,#11,#9);
#431=IFCLOCALPLACEMENT(#16,#430);
#432=IFCBUILDINGELEMENTPROXY('SE01',#3,'SurfExtrusion',$,$,#431,#428,$,$);

#500=IFCRELCONTAINEDINSPATIALSTRUCTURE('RC01',#3,$,$,(#114,#213,#228,#309,#361,#412,#432),#21);
ENDSEC;
END-ISO-10303-21;
