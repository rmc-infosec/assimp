ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('seed.ifc','2024-01-01',(''),(''),'','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
#1=IFCORGANIZATION($,'Fuzz','Mapped items seed',$,$);
#2=IFCAPPLICATION(#1,'1.0','FuzzMap','FuzzMap');
#3=IFCOWNERHISTORY(#1,#2,$,.NOCHANGE.,$,$,$,0);
#4=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#5=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#6=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#7=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#8=IFCUNITASSIGNMENT((#4,#5,#6,#7));
#9=IFCDIRECTION((1.,0.,0.));
#10=IFCDIRECTION((0.,1.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#12,#11,#9);
#14=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#13,$);
#15=IFCPROJECT('M001',#3,'MappedProject',$,$,$,$,(#14),#8);
#16=IFCLOCALPLACEMENT($,#13);
#17=IFCSITE('M002',#3,'Site',$,$,#16,$,$,.ELEMENT.,$,$,$,$,$);
#18=IFCRELAGGREGATES('M003',#3,$,$,#15,(#17));
#19=IFCBUILDING('M004',#3,'Building',$,$,#16,$,$,.ELEMENT.,$,$,$);
#20=IFCRELAGGREGATES('M005',#3,$,$,#17,(#19));
#21=IFCBUILDINGSTOREY('M006',#3,'Floor',$,$,#16,$,$,.ELEMENT.,0.);
#22=IFCRELAGGREGATES('M007',#3,$,$,#19,(#21));
#23=IFCAXIS2PLACEMENT2D(#24,#25);
#24=IFCCARTESIANPOINT((0.,0.));
#25=IFCDIRECTION((1.,0.));

/* === Source shape: a column (extruded rectangle) === */
#100=IFCRECTANGLEPROFILEDEF(.AREA.,'colprof',#23,0.3,0.3);
#101=IFCEXTRUDEDAREASOLID(#100,#13,#11,3.0);
#102=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#101));
#103=IFCREPRESENTATIONMAP(#13,#102);

/* === MappedItem 1: identity transform === */
#104=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#12,1.0,$);
#105=IFCMAPPEDITEM(#103,#104);
#106=IFCSHAPEREPRESENTATION(#14,'Body','MappedRepresentation',(#105));
#107=IFCPRODUCTDEFINITIONSHAPE($,$,(#106));
#108=IFCCOLUMN('MI01',#3,'Col_Identity',$,$,#16,#107,$);

/* === MappedItem 2: translated === */
#110=IFCCARTESIANPOINT((3.,0.,0.));
#111=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#110,1.0,$);
#112=IFCMAPPEDITEM(#103,#111);
#113=IFCSHAPEREPRESENTATION(#14,'Body','MappedRepresentation',(#112));
#114=IFCPRODUCTDEFINITIONSHAPE($,$,(#113));
#115=IFCCOLUMN('MI02',#3,'Col_Translated',$,$,#16,#114,$);

/* === MappedItem 3: scaled (2x) with rotation axis === */
#120=IFCCARTESIANPOINT((6.,0.,0.));
#121=IFCDIRECTION((0.707,0.707,0.));
#122=IFCDIRECTION((0.,0.,1.));
#123=IFCCARTESIANTRANSFORMATIONOPERATOR3D(#121,#122,#120,2.0,#11);
#124=IFCMAPPEDITEM(#103,#123);
#125=IFCSHAPEREPRESENTATION(#14,'Body','MappedRepresentation',(#124));
#126=IFCPRODUCTDEFINITIONSHAPE($,$,(#125));
#127=IFCCOLUMN('MI03',#3,'Col_ScaledRotated',$,$,#16,#126,$);

/* === MappedItem 4: using a different source (circle profile) === */
#130=IFCCIRCLEPROFILEDEF(.AREA.,'pipeprof',#23,0.15);
#131=IFCEXTRUDEDAREASOLID(#130,#13,#11,2.0);
#132=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#131));
#133=IFCREPRESENTATIONMAP(#13,#132);
#134=IFCCARTESIANPOINT((9.,0.,0.));
#135=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#134,1.0,$);
#136=IFCMAPPEDITEM(#133,#135);
#137=IFCSHAPEREPRESENTATION(#14,'Body','MappedRepresentation',(#136));
#138=IFCPRODUCTDEFINITIONSHAPE($,$,(#137));
#139=IFCBUILDINGELEMENTPROXY('MI04',#3,'Pipe_Mapped',$,$,#16,#138,$,$);

/* === IfcSpace entity === */
/* Exercises the IfcSpace building element processing path */
#200=IFCRECTANGLEPROFILEDEF(.AREA.,'roomprof',#23,4.0,5.0);
#201=IFCEXTRUDEDAREASOLID(#200,#13,#11,2.7);
#202=IFCSHAPEREPRESENTATION(#14,'Body','SweptSolid',(#201));
#203=IFCPRODUCTDEFINITIONSHAPE($,$,(#202));
#204=IFCCARTESIANPOINT((0.,10.,0.));
#205=IFCAXIS2PLACEMENT3D(#204,#11,#9);
#206=IFCLOCALPLACEMENT(#16,#205);
#207=IFCSPACE('SP01',#3,'Room101','Office space',$,#206,#203,$,.ELEMENT.,.INTERNAL.,$);

/* === IfcAnnotation entity === */
/* Exercises the IfcAnnotation processing path */
#220=IFCCARTESIANPOINT((0.,0.,0.));
#221=IFCCARTESIANPOINT((1.,0.,0.));
#222=IFCCARTESIANPOINT((1.,0.,1.));
#223=IFCPOLYLINE((#220,#221,#222));
#224=IFCSHAPEREPRESENTATION(#14,'Body','Curve2D',(#223));
#225=IFCPRODUCTDEFINITIONSHAPE($,$,(#224));
#226=IFCCARTESIANPOINT((15.,10.,0.));
#227=IFCAXIS2PLACEMENT3D(#226,#11,#9);
#228=IFCLOCALPLACEMENT(#16,#227);
#229=IFCANNOTATION('AN01',#3,'DimensionLine',$,$,#228,#225);

/* === IfcSurfaceStyle with IfcSurfaceStyleRendering === */
/* Exercises FillMaterial with all color properties + transparency */
#300=IFCCOLOURRGB($,0.8,0.2,0.2);
#301=IFCCOLOURRGB($,0.9,0.3,0.3);
#302=IFCCOLOURRGB($,1.0,1.0,1.0);
#303=IFCCOLOURRGB($,0.1,0.1,0.1);
#304=IFCCOLOURRGB($,0.5,0.5,0.5);
#305=IFCSURFACESTYLERENDERING(#300,0.3,#301,#303,$,#302,#304,IFCSPECULAREXPONENT(64.),.PHONG.);
#306=IFCSURFACESTYLE('RedGloss',.BOTH.,(#305));
#307=IFCPRESENTATIONSTYLEASSIGNMENT((#306));
#308=IFCSTYLEDITEM(#101,(#307),$);

/* === IfcSurfaceStyle with simpler shading (no specular) === */
#310=IFCCOLOURRGB($,0.3,0.6,0.3);
#311=IFCSURFACESTYLESHADING(#310);
#312=IFCSURFACESTYLE('GreenFlat',.BOTH.,(#311));
#313=IFCPRESENTATIONSTYLEASSIGNMENT((#312));
#314=IFCSTYLEDITEM(#131,(#313),$);

/* === IfcSurfaceStyle with BLINN reflectance === */
#320=IFCCOLOURRGB($,0.2,0.2,0.8);
#321=IFCCOLOURRGB($,0.3,0.3,0.9);
#322=IFCCOLOURRGB($,0.8,0.8,1.0);
#323=IFCSURFACESTYLERENDERING(#320,0.0,#321,$,$,$,#322,IFCSPECULAREXPONENT(32.),.BLINN.);
#324=IFCSURFACESTYLE('BlueBlinn',.BOTH.,(#323));
#325=IFCPRESENTATIONSTYLEASSIGNMENT((#324));
#326=IFCSTYLEDITEM(#201,(#325),$);

/* === IfcRelDefinesByType linking mapped columns === */
#400=IFCCOLUMNTYPE('CT01',#3,'ColumnType',$,$,$,(#103),$,$,.COLUMN.);
#401=IFCRELDEFINESBYTYPE('RD01',#3,$,$,(#108,#115,#127),#400);

/* === Containment === */
#500=IFCRELCONTAINEDINSPATIALSTRUCTURE('RC01',#3,$,$,(#108,#115,#127,#139,#207,#229),#21);
ENDSEC;
END-ISO-10303-21;
