#VRML V2.0 utf8

DEF A Transform {
  translation -3 0 0
  children [
    DEF ShpA Shape {
      geometry Box { size 0.5 0.5 0.5 }
      appearance DEF AppA Appearance {
        material DEF MatA Material { diffuseColor 1 0 0 }
      }
    }
  ]
}
DEF B Transform {
  translation 0 0 0
  children [
    Shape {
      geometry Sphere { radius 0.3 }
      appearance USE AppA
    }
  ]
}
DEF C Transform {
  translation 3 0 0
  children [ USE ShpA ]
}
