#VRML V2.0 utf8

Group {
  children [
    DEF TS TouchSensor {}
    DEF PS ProximitySensor {
      center 0 0 0
      size 10 10 10
      enabled TRUE
    }
    DEF VS VisibilitySensor {
      center 0 0 0
      size 5 5 5
    }
    DEF PD PlaneSensor {
      minPosition -5 -5
      maxPosition 5 5
      enabled TRUE
      autoOffset TRUE
    }
    DEF CS CylinderSensor {
      minAngle 0
      maxAngle 6.28
      enabled TRUE
    }
    DEF SS SphereSensor {
      enabled TRUE
      autoOffset TRUE
    }
    Shape {
      geometry Box { size 1 1 1 }
      appearance Appearance {
        material Material { diffuseColor 0.5 0.8 0.5 }
      }
    }
  ]
}
