          Shape {
            geometry IndexedFaceSet {
              coord Coordinate {
                point [ 0 0 0, 1 0 0, 0.5 1 0 ]
              }
              coordIndex [ 0 1 2 -1 ]
            }
          }
        ] }
      ] }
    ] }
  ] }
