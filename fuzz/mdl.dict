# MDL (Quake/Half-Life) format dictionary
# Magic bytes
"IDPO"  # Quake MDL
"IDP2"  # Quake 2 MD2
"IDST"  # Half-Life MDL
"IDSQ"  # Half-Life sequence
"\x2c\x00\x00\x00"  # MDL version 6

# HL MDL sections
"$modelname"
"$cd"
"$cdtexture"
"$scale"
"$root"
"$bbox"
"$cbox"
"$eyeposition"
"$body"
"$bodygroup"
"$controller"
"$attachment"
"$hbox"
"$sequence"
"$sequencegroup"
"$texrendermode"
